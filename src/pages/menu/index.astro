---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts } from '../../lib/sanity';

const products = await getProducts();
---

<BaseLayout 
  title="Menu Jajanan Tradisional | Rasanesia"
  description="Pilihan lengkap aneka kue basah tradisional nusantara, lezat, higienis, dan dibuat fresh setiap hari di Surakarta."
>
  <!-- Page Header -->
  <section class="bg-brand-cream/40 border-b border-brand-cream-dark py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <nav class="flex justify-center items-center gap-2 text-xs text-brand-muted mb-3" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-brown">Beranda</a>
        <span>/</span>
        <span class="text-brand-brown font-semibold">Menu Jajanan</span>
      </nav>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-brand-dark">
        Katalog Menu Tradisional
      </h1>
      <p class="text-sm sm:text-base text-brand-muted mt-3 max-w-2xl mx-auto">
        Koleksi kue basah, jajanan gurih, dan kudapan manis nusantara yang dibuat dari bahan alami tanpa pengawet kimia buatan.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8">
        <button 
          type="button" 
          data-filter="all" 
          class="menu-filter-btn px-5 py-2 rounded-full text-xs font-semibold bg-brand-brown text-brand-white transition-all shadow-xs"
        >
          Semua Menu
        </button>
        <button 
          type="button" 
          data-filter="Gurih" 
          class="menu-filter-btn px-5 py-2 rounded-full text-xs font-semibold bg-brand-white text-brand-dark border border-brand-cream-dark hover:bg-brand-cream transition-all"
        >
          Jajanan Gurih / Asin
        </button>
        <button 
          type="button" 
          data-filter="Manis" 
          class="menu-filter-btn px-5 py-2 rounded-full text-xs font-semibold bg-brand-white text-brand-dark border border-brand-cream-dark hover:bg-brand-cream transition-all"
        >
          Kudapan Manis
        </button>
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {products.map(product => (
          <div 
            data-product-item
            data-taste={product.tasteProfile}
            class="bg-brand-white border border-brand-cream-dark rounded-2xl overflow-hidden shadow-xs hover:shadow-card transition-all duration-300 flex flex-col justify-between group"
          >
            <!-- Image & Badges -->
            <div class="aspect-square overflow-hidden bg-brand-cream relative">
              <a href={`/menu/${product.slug}/`}>
                <img 
                  src={product.image} 
                  alt={product.name} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="400"
                  height="400"
                />
              </a>
              <span class="absolute top-3 left-3 bg-brand-white/95 text-brand-brown text-[10px] font-bold px-2.5 py-1 rounded-full shadow-xs">
                {product.tasteProfile}
              </span>
              <span class="absolute top-3 right-3 bg-brand-cream-dark text-brand-dark text-[10px] font-medium px-2 py-0.5 rounded-md">
                Min {product.minOrder || 15} pcs
              </span>
            </div>

            <!-- Content -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <a href={`/menu/${product.slug}/`} class="hover:text-brand-brown transition-colors">
                  <h3 class="font-serif text-lg font-bold text-brand-dark line-clamp-1 mb-1">
                    {product.name}
                  </h3>
                </a>
                <p class="text-xs text-brand-muted line-clamp-2 mb-3 leading-relaxed">
                  {product.description}
                </p>
                <div class="mb-4">
                  {product.price ? (
                    <div>
                      <span data-sync-product-price={product.id} class="font-serif text-xl font-bold text-brand-brown">
                        Rp {product.price.toLocaleString('id-ID')}
                      </span>
                      <span class="text-xs text-brand-muted">/{product.priceUnit || 'pcs'}</span>
                    </div>
                  ) : (
                    <div>
                      <span data-sync-product-price={product.id} class="text-xs font-semibold text-brand-brown">Hubungi via WA</span>
                      <span class="text-[10px] text-brand-muted block">Harga per pesanan</span>
                    </div>
                  )}
                </div>
              </div>

              <!-- Buttons -->
              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-brand-cream-dark/60">
                <a 
                  href={`/menu/${product.slug}/`} 
                  class="w-full text-center py-2.5 rounded-full border border-brand-cream-dark text-brand-dark hover:bg-brand-cream text-xs font-semibold transition-colors"
                >
                  Detail
                </a>
                {product.price ? (
                  <button 
                    type="button"
                    data-add-to-cart
                    data-id={product.id}
                    data-name={product.name}
                    data-price={product.price}
                    data-unit={product.priceUnit || 'pcs'}
                    data-image={product.image}
                    class="w-full bg-brand-brown hover:bg-brand-brown-dark text-brand-white text-xs font-semibold py-2.5 rounded-full shadow-xs transition-colors"
                  >
                    + Keranjang
                  </button>
                ) : (
                  <a 
                    href={`/menu/${product.slug}/`}
                    class="w-full bg-brand-green hover:bg-brand-green-dark text-brand-white text-center text-xs font-semibold py-2.5 rounded-full shadow-xs transition-colors"
                  >
                    Pesan WA
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initClientSync } from '../../utils/clientSync';

  // Run live sync with localStorage (from UMKM Admin)
  initClientSync();

  // Add to cart click event
  document.querySelectorAll('[data-add-to-cart]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name');
      const price = parseInt(target.getAttribute('data-price') || '0', 10);
      const unit = target.getAttribute('data-unit') || 'pcs';
      const image = target.getAttribute('data-image') || '';

      window.dispatchEvent(new CustomEvent('add-to-cart', {
        detail: { id, name, price, unit, image, quantity: 1 }
      }));
    });
  });

  // Filter Buttons
  const filterBtns = document.querySelectorAll('.menu-filter-btn');
  const items = document.querySelectorAll('[data-product-item]');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button styling
      filterBtns.forEach(b => {
        b.classList.remove('bg-brand-brown', 'text-brand-white');
        b.classList.add('bg-brand-white', 'text-brand-dark');
      });
      btn.classList.add('bg-brand-brown', 'text-brand-white');
      btn.classList.remove('bg-brand-white', 'text-brand-dark');

      // Filter products
      items.forEach(item => {
        const taste = item.getAttribute('data-taste');
        if (filter === 'all' || (taste && taste.includes(filter || ''))) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
