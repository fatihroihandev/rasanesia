---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts } from '../../lib/sanity';

const products = await getProducts();
---

<BaseLayout 
  title="Menu Jajanan Tradisional | Rasanesia"
  description="Pilihan lengkap aneka kue basah tradisional nusantara, lezat, higienis, dan dibuat fresh setiap hari di Surakarta."
>
  <!-- Semantic Page Header -->
  <header aria-labelledby="menu-page-heading" class="page-header-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Beranda</a></li>
          <li aria-current="page" class="breadcrumb-current">Menu Jajanan</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
        <div class="lg:col-span-7">
          <span class="editorial-kicker">KATALOG 01 / KUDAPAN PASAR NUSANTARA</span>
          <h1 id="menu-page-heading" class="font-serif text-3xl sm:text-5xl font-bold text-content-primary mt-2">
            Katalog Menu Tradisional
          </h1>
        </div>
        <div class="lg:col-span-5">
          <p class="text-sm sm:text-base text-content-secondary leading-relaxed m-0">
            Koleksi kue basah, jajanan gurih, dan kudapan manis Nusantara yang dibuat dari bahan alami tanpa pengawet kimia buatan.
          </p>
        </div>
      </div>

      <!-- Semantic Search & Filter Controls -->
      <search role="search" aria-label="Filter dan pencarian menu jajanan" class="mt-8 pt-6 border-t border-line-subtle flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter profil rasa jajanan">
          <button 
            type="button" 
            data-filter="all" 
            aria-pressed="true"
            class="menu-filter-btn px-5 min-h-[44px] rounded-full text-xs font-semibold bg-action-primary text-content-inverse transition-all shadow-xs"
          >
            Semua Menu
          </button>
          <button 
            type="button" 
            data-filter="Gurih" 
            aria-pressed="false"
            class="menu-filter-btn px-5 min-h-[44px] rounded-full text-xs font-semibold bg-surface-primary text-content-primary border border-line-subtle hover:bg-surface-subtle transition-all"
          >
            Jajanan Gurih / Asin
          </button>
          <button 
            type="button" 
            data-filter="Manis" 
            aria-pressed="false"
            class="menu-filter-btn px-5 min-h-[44px] rounded-full text-xs font-semibold bg-surface-primary text-content-primary border border-line-subtle hover:bg-surface-subtle transition-all"
          >
            Kudapan Manis
          </button>
        </div>

        <div class="relative w-full md:w-72">
          <label for="menu-search-input" class="sr-only">Cari nama jajanan</label>
          <input
            type="search"
            id="menu-search-input"
            placeholder="Cari lemper, sosis solo, lumpur..."
            class="w-full min-h-[44px] pl-10 pr-4 py-2.5 rounded-full text-xs bg-surface-primary border border-line-subtle text-content-primary placeholder:text-content-secondary focus:ring-2 focus:ring-brand-brown outline-none"
          />
          <svg class="w-4 h-4 text-content-secondary absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </search>
    </div>
  </header>

  <!-- Products Grid Section -->
  <section aria-label="Daftar produk jajanan pasar" class="py-16 bg-surface-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {products.map(product => (
          <article 
            data-product-item
            data-taste={product.tasteProfile}
            data-name-search={product.name.toLowerCase()}
            class="semantic-card flex flex-col justify-between group"
          >
            <!-- Semantic Figure & Badges -->
            <figure class="aspect-square overflow-hidden bg-surface-subtle relative m-0">
              <a href={`/menu/${product.slug}/`} aria-label={`Lihat detail ${product.name}`}>
                <img 
                  src={product.image} 
                  alt={product.name} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="400"
                  height="400"
                />
              </a>
              <figcaption class="contents">
                <span class="absolute top-3 left-3 bg-surface-primary/95 text-content-accent text-[11px] font-bold px-3 py-1 rounded-full shadow-xs">
                  {product.tasteProfile}
                </span>
                <span class="absolute top-3 right-3 bg-brand-cream-dark/95 text-content-primary text-[11px] font-semibold px-2.5 py-1 rounded-full tabular-price">
                  Min {product.minOrder || 15} pcs
                </span>
              </figcaption>
            </figure>

            <!-- Content -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <header>
                  <h2 class="font-serif text-lg font-bold text-content-primary line-clamp-1">
                    <a href={`/menu/${product.slug}/`} class="hover:text-content-accent transition-colors min-h-[40px] inline-flex items-center">
                      {product.name}
                    </a>
                  </h2>
                </header>
                <p class="text-xs text-content-secondary line-clamp-2 mb-4 leading-relaxed">
                  {product.description}
                </p>
                <dl class="mb-4 m-0">
                  <dt class="sr-only">Harga Satuan</dt>
                  <dd class="m-0">
                    {product.price ? (
                      <div>
                        <span data-sync-product-price={product.id} class="font-serif text-xl font-bold text-content-accent tabular-price">
                          Rp {product.price.toLocaleString('id-ID')}
                        </span>
                        <span class="text-xs text-content-secondary">/{product.priceUnit || 'pcs'}</span>
                      </div>
                    ) : (
                      <div>
                        <span data-sync-product-price={product.id} class="text-xs font-semibold text-content-accent">Hubungi via WA</span>
                        <span class="text-[11px] text-content-secondary block">Harga per pesanan</span>
                      </div>
                    )}
                  </dd>
                </dl>
              </div>

              <!-- Card Footer Actions -->
              <footer class="grid grid-cols-2 gap-2.5 pt-3 border-t border-line-subtle/60">
                <a 
                  href={`/menu/${product.slug}/`} 
                  class="w-full min-h-[44px] inline-flex items-center justify-center rounded-full border border-line-subtle text-content-primary hover:bg-surface-subtle text-xs font-semibold transition-colors"
                >
                  Detail
                </a>
                {product.price ? (
                  <button 
                    type="button"
                    data-add-to-cart
                    data-id={product.id}
                    data-name={product.name}
                    data-price={product.price}
                    data-unit={product.priceUnit || 'pcs'}
                    data-image={product.image}
                    class="w-full min-h-[44px] inline-flex items-center justify-center bg-action-primary hover:bg-action-primary-hover text-content-inverse text-xs font-semibold rounded-full shadow-xs transition-colors"
                  >
                    + Keranjang
                  </button>
                ) : (
                  <a 
                    href={`/menu/${product.slug}/`}
                    class="w-full min-h-[44px] inline-flex items-center justify-center bg-action-whatsapp hover:bg-action-whatsapp-hover text-content-inverse text-center text-xs font-semibold rounded-full shadow-xs transition-colors"
                  >
                    Pesan WA
                  </a>
                )}
              </footer>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty Filter State -->
      <aside id="menu-empty-filter" aria-live="polite" class="hidden py-12 text-center space-y-3">
        <p class="font-serif text-xl font-bold text-content-primary">Tidak ada menu yang cocok dengan pencarian Anda</p>
        <p class="text-xs text-content-secondary">Coba kata kunci lain atau tampilkan seluruh menu jajanan.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { initClientSync } from '../../utils/clientSync';

  initClientSync();

  document.querySelectorAll('[data-add-to-cart]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name');
      const price = parseInt(target.getAttribute('data-price') || '0', 10);
      const unit = target.getAttribute('data-unit') || 'pcs';
      const image = target.getAttribute('data-image') || '';

      window.dispatchEvent(new CustomEvent('add-to-cart', {
        detail: { id, name, price, unit, image, quantity: 1 }
      }));
    });
  });

  let activeFilter = 'all';
  let searchQuery = '';
  const filterBtns = document.querySelectorAll('.menu-filter-btn');
  const searchInput = document.getElementById('menu-search-input') as HTMLInputElement | null;
  const emptyState = document.getElementById('menu-empty-filter');

  function applyMenuFilters() {
    const items = document.querySelectorAll('[data-product-item]');
    let visibleCount = 0;

    items.forEach(item => {
      const taste = item.getAttribute('data-taste') || '';
      const nameText = (item.getAttribute('data-name-search') || item.textContent || '').toLowerCase();
      const matchesTaste = activeFilter === 'all' || taste.includes(activeFilter);
      const matchesSearch = !searchQuery || nameText.includes(searchQuery);

      if (matchesTaste && matchesSearch) {
        (item as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.getAttribute('data-filter') || 'all';

      filterBtns.forEach(b => {
        b.setAttribute('aria-pressed', 'false');
        b.classList.remove('bg-action-primary', 'text-content-inverse');
        b.classList.add('bg-surface-primary', 'text-content-primary');
      });
      btn.setAttribute('aria-pressed', 'true');
      btn.classList.add('bg-action-primary', 'text-content-inverse');
      btn.classList.remove('bg-surface-primary', 'text-content-primary');

      applyMenuFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    searchQuery = (searchInput.value || '').trim().toLowerCase();
    applyMenuFilters();
  });
</script>
