---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductBySlug } from '../../lib/sanity';
import { createProductInquiryUrl } from '../../utils/whatsapp';

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : undefined;

if (!product) {
  return Astro.redirect('/404/');
}

const waOrderUrl = createProductInquiryUrl(
  product.name, 
  product.price ? `Rp ${product.price.toLocaleString('id-ID')} / ${product.priceUnit || 'pcs'}` : 'Harga Menyesuaikan Jumlah Pesanan'
);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "image": new URL(product.image, Astro.url.origin).href,
  "brand": {
    "@type": "Brand",
    "name": "Rasanesia"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "IDR",
    "price": product.price || 0,
    "availability": product.available !== false ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "url": Astro.url.href
  }
};
---

<BaseLayout 
  title={`${product.name} | Rasanesia`}
  description={product.description}
  image={product.image}
  preloadHeroImage={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <article itemscope itemtype="https://schema.org/Product" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <!-- Semantic Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="breadcrumb-list">
        <li><a href="/" class="breadcrumb-link">Beranda</a></li>
        <li><a href="/menu/" class="breadcrumb-link">Menu Jajanan</a></li>
        <li aria-current="page" class="breadcrumb-current">{product.name}</li>
      </ol>
    </nav>

    <!-- Product Detail Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Product Figure -->
      <figure class="lg:col-span-6 m-0">
        <div class="rounded-3xl overflow-hidden border-2 border-line-subtle shadow-card bg-surface-subtle aspect-square relative">
          <img 
            itemprop="image"
            src={product.image} 
            alt={product.name} 
            class="w-full h-full object-cover"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="absolute top-4 left-4 bg-surface-inverse/85 text-content-inverse-muted font-mono text-[10px] uppercase tracking-widest px-3 py-1 rounded-full">
            SPESIMEN KUDAPAN • {product.tasteProfile}
          </figcaption>
        </div>
      </figure>

      <!-- Right Column: Semantic Product Info & Actions -->
      <div class="lg:col-span-6 space-y-6">
        <header>
          <ul class="flex flex-wrap items-center gap-2 mb-3 list-none m-0 p-0">
            <li class="px-3.5 py-1 rounded-full bg-surface-subtle text-content-accent text-xs font-bold">
              {product.categoryLabel || 'Jajanan Tradisional'}
            </li>
            <li class="px-3.5 py-1 rounded-full bg-surface-canvas text-content-primary text-xs font-semibold border border-line-subtle">
              Profil Rasa: {product.tasteProfile}
            </li>
          </ul>
          <h1 itemprop="name" class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-content-primary">
            {product.name}
          </h1>
        </header>

        <!-- Semantic Price & Availability Definition List -->
        <dl class="p-5 rounded-2xl bg-surface-subtle/45 border border-line-subtle flex flex-wrap items-baseline justify-between gap-4 m-0">
          <div>
            <dt class="text-xs text-content-secondary block mb-0.5">Harga per satuan:</dt>
            <dd class="m-0">
              {product.price ? (
                <div>
                  <span data-sync-product-price={product.id} class="font-serif text-3xl font-bold text-content-accent tabular-price">
                    Rp {product.price.toLocaleString('id-ID')}
                  </span>
                  <span class="text-xs text-content-secondary">/{product.priceUnit || 'pcs'}</span>
                </div>
              ) : (
                <div class="pt-1">
                  <span data-sync-product-price={product.id} class="text-sm font-semibold text-content-accent">Hubungi via WhatsApp</span>
                  <span class="text-[11px] text-content-secondary block">Harga dikonfirmasi sesuai pesanan</span>
                </div>
              )}
            </dd>
          </div>
          <div>
            <dt class="sr-only">Status Produksi</dt>
            <dd class="text-xs font-semibold text-status-success bg-brand-green/10 px-3 py-1 rounded-full m-0">
              ✓ Diproduksi Segar Sesuai Jadwal
            </dd>
          </div>
        </dl>

        <p itemprop="description" class="text-sm sm:text-base text-content-secondary leading-relaxed">
          {product.description}
        </p>

        <!-- Composition / Ingredients Section -->
        {product.ingredients && product.ingredients.length > 0 && (
          <section aria-labelledby="ingredients-heading" class="space-y-3 pt-2">
            <h2 id="ingredients-heading" class="font-serif text-base font-bold text-content-primary">Komposisi Bahan Pilihan:</h2>
            <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
              {product.ingredients.map(ing => (
                <li class="px-3.5 py-1.5 rounded-xl bg-surface-primary border border-line-subtle text-xs font-medium text-content-primary">
                  <span class="text-status-success font-bold" aria-hidden="true">✓</span> {ing}
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Order Information Aside -->
        <aside aria-labelledby="order-terms-heading" class="p-5 rounded-2xl bg-surface-canvas border border-line-subtle text-xs text-content-primary space-y-2">
          <h2 id="order-terms-heading" class="text-xs font-bold text-content-accent uppercase tracking-wider m-0">Ketentuan Pemesanan:</h2>
          <ul class="space-y-1.5 list-disc pl-4 m-0 text-content-primary/90">
            <li>Minimal pemesanan satuan: <strong>{product.minOrder || 15} {product.priceUnit || 'pcs'}</strong> (atau digabung dalam snack box).</li>
            <li>Rekomendasi waktu pemesanan: H-2 sebelum tanggal acara.</li>
            <li>Dibuat segar di hari pengiriman tanpa bahan pengawet.</li>
          </ul>
        </aside>

        <!-- Order CTAs Footer -->
        <footer class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-line-subtle">
          {product.price ? (
            <button 
              type="button"
              id="detail-add-cart-btn"
              data-id={product.id}
              data-name={product.name}
              data-price={product.price}
              data-unit={product.priceUnit || 'pcs'}
              data-image={product.image}
              class="flex-1 min-h-[48px] bg-action-primary hover:bg-action-primary-hover text-content-inverse font-semibold py-3.5 px-6 rounded-full shadow-soft hover:shadow-hover transition-all text-sm flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 text-brand-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Tambah ke Keranjang</span>
            </button>
          ) : null}

          <a 
            href={waOrderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 min-h-[48px] bg-action-whatsapp hover:bg-action-whatsapp-hover text-content-inverse font-semibold py-3.5 px-6 rounded-full shadow-soft transition-all text-sm flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>Pesan via WhatsApp</span>
          </a>
        </footer>

      </div>

    </div>
  </article>
</BaseLayout>

<script>
  import { initClientSync } from '../../utils/clientSync';

  initClientSync();

  const addBtn = document.getElementById('detail-add-cart-btn');
  addBtn?.addEventListener('click', () => {
    const id = addBtn.getAttribute('data-id');
    const name = addBtn.getAttribute('data-name');
    const price = parseInt(addBtn.getAttribute('data-price') || '0', 10);
    const unit = addBtn.getAttribute('data-unit') || 'pcs';
    const image = addBtn.getAttribute('data-image') || '';

    window.dispatchEvent(new CustomEvent('add-to-cart', {
      detail: { id, name, price, unit, image, quantity: 1 }
    }));
  });
</script>
