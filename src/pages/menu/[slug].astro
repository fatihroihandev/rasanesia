---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductBySlug } from '../../lib/sanity';
import { createProductInquiryUrl } from '../../utils/whatsapp';

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : undefined;

if (!product) {
  return Astro.redirect('/404/');
}

const waOrderUrl = createProductInquiryUrl(
  product.name, 
  product.price ? `Rp ${product.price.toLocaleString('id-ID')} / ${product.priceUnit || 'pcs'}` : 'Harga Menyesuaikan Jumlah Pesanan'
);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "image": product.image,
  "brand": {
    "@type": "Brand",
    "name": "Rasanesia"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "IDR",
    "price": product.price || 0,
    "availability": product.available !== false ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "url": Astro.url.href
  }
};
---

<BaseLayout 
  title={`${product.name} | Rasanesia`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-brand-muted mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-brown">Beranda</a>
      <span>/</span>
      <a href="/menu/" class="hover:text-brand-brown">Menu Jajanan</a>
      <span>/</span>
      <span class="text-brand-brown font-semibold truncate">{product.name}</span>
    </nav>

    <!-- Product Detail Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Image -->
      <div class="lg:col-span-6">
        <div class="rounded-3xl overflow-hidden border-2 border-brand-cream-dark shadow-card bg-brand-cream aspect-square">
          <img 
            src={product.image} 
            alt={product.name} 
            class="w-full h-full object-cover"
            width="600"
            height="600"
            loading="eager"
          />
        </div>
      </div>

      <!-- Right Column: Info & Actions -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-3 py-1 rounded-full bg-brand-cream text-brand-brown text-xs font-semibold">
              {product.categoryLabel || 'Jajanan Tradisional'}
            </span>
            <span class="px-3 py-1 rounded-full bg-brand-cream-light text-brand-dark text-xs font-medium border border-brand-cream-dark">
              Rasa: {product.tasteProfile}
            </span>
          </div>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-dark">
            {product.name}
          </h1>
        </div>

        <!-- Price (Addendum Section 5.2: Satuan jelas, fallback jika belum tersedia) -->
        <div class="p-4 rounded-2xl bg-brand-cream/40 border border-brand-cream-dark inline-block min-w-[200px]">
          <span class="text-xs text-brand-muted block">Harga per satuan:</span>
          {product.price ? (
            <div>
              <span data-sync-product-price={product.id} class="font-serif text-3xl font-bold text-brand-brown">
                Rp {product.price.toLocaleString('id-ID')}
              </span>
              <span class="text-xs text-brand-muted">/{product.priceUnit || 'pcs'}</span>
            </div>
          ) : (
            <div class="pt-1">
              <span data-sync-product-price={product.id} class="text-sm font-semibold text-brand-brown">Hubungi via WhatsApp</span>
              <span class="text-[11px] text-brand-muted block">Harga dikonfirmasi sesuai pesanan</span>
            </div>
          )}
        </div>

        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          {product.description}
        </p>

        <!-- Composition / Ingredients -->
        {product.ingredients && product.ingredients.length > 0 && (
          <div class="space-y-3 pt-2">
            <h3 class="font-serif text-base font-bold text-brand-dark">Komposisi Bahan Pilihan:</h3>
            <div class="flex flex-wrap gap-2">
              {product.ingredients.map(ing => (
                <span class="px-3 py-1 rounded-lg bg-brand-white border border-brand-cream-dark text-xs text-brand-dark">
                  ✓ {ing}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Order Information Box -->
        <div class="p-4 rounded-xl bg-brand-cream-light border border-brand-cream-dark text-xs text-brand-dark space-y-1.5">
          <p class="font-semibold text-brand-brown">Ketentuan Pemesanan:</p>
          <p>• Minimal pemesanan satuan: <strong>{product.minOrder || 15} {product.priceUnit || 'pcs'}</strong> (atau digabung dalam snack box).</p>
          <p>• Rekomendasi waktu pemesanan: H-2 sebelum tanggal acara.</p>
          <p>• Dibuat segar di hari pengiriman tanpa bahan pengawet.</p>
        </div>

        <!-- Order CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-brand-cream-dark">
          {product.price ? (
            <button 
              type="button"
              id="detail-add-cart-btn"
              data-id={product.id}
              data-name={product.name}
              data-price={product.price}
              data-unit={product.priceUnit || 'pcs'}
              data-image={product.image}
              class="flex-1 bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-semibold py-3.5 px-6 rounded-full shadow-soft hover:shadow-hover transition-all text-sm flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Tambah ke Keranjang</span>
            </button>
          ) : null}

          <a 
            href={waOrderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-brand-green hover:bg-brand-green-dark text-brand-white font-semibold py-3.5 px-6 rounded-full shadow-soft transition-all text-sm flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>Pesan via WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { initClientSync } from '../../utils/clientSync';

  // Run live sync with localStorage (from UMKM Admin)
  initClientSync();

  const addBtn = document.getElementById('detail-add-cart-btn');
  addBtn?.addEventListener('click', () => {
    const id = addBtn.getAttribute('data-id');
    const name = addBtn.getAttribute('data-name');
    const price = parseInt(addBtn.getAttribute('data-price') || '0', 10);
    const unit = addBtn.getAttribute('data-unit') || 'pcs';
    const image = addBtn.getAttribute('data-image') || '';

    window.dispatchEvent(new CustomEvent('add-to-cart', {
      detail: { id, name, price, unit, image, quantity: 1 }
    }));
  });
</script>
