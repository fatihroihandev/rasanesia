<script define:vars={{ initialBoxes: snackBoxes.slice(0, 3) }}>
  // Signature Moment: Interactive Box Curator State
  let activeIdx = 0;
  let activeQty = 30;

  const tabBtns = document.querySelectorAll('.curator-tab-btn');
  const qtyBtns = document.querySelectorAll('.curator-qty-btn');
  const titleEl = document.getElementById('curator-title');
  const descEl = document.getElementById('curator-desc');
  const packBadgeEl = document.getElementById('curator-pack-badge');
  const itemsListEl = document.getElementById('curator-items-list');
  const totalPriceEl = document.getElementById('curator-total-price');
  const qtyInlineEl = document.getElementById('curator-qty-inline');
  const qtyBadgeEl = document.getElementById('curator-qty-badge');
  const btnQtyEl = document.getElementById('curator-btn-qty');
  const addCartBtn = document.getElementById('curator-add-cart-btn');

  function renderCurator() {
    const box = initialBoxes[activeIdx] || initialBoxes[0];
    if (!box) return;

    if (titleEl) titleEl.textContent = box.name;
    if (descEl) descEl.textContent = box.description;
    if (packBadgeEl) packBadgeEl.textContent = `Kemasan: ${box.packagingType || 'Kraft Box Ramah Lingkungan'}`;
    if (qtyInlineEl) qtyInlineEl.textContent = String(activeQty);
    if (qtyBadgeEl) qtyBadgeEl.textContent = `${activeQty} Box`;
    if (btnQtyEl) btnQtyEl.textContent = String(activeQty);
    if (totalPriceEl) {
      totalPriceEl.textContent = `Rp ${(box.price * activeQty).toLocaleString('id-ID')}`;
    }

    if (itemsListEl && Array.isArray(box.includes)) {
      itemsListEl.innerHTML = box.includes.map((inc, i) => `
        <li class="p-3.5 rounded-2xl bg-surface-canvas border border-line-subtle flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-action-primary text-content-inverse text-xs font-bold flex items-center justify-center shrink-0">${i + 1}</span>
          <span class="text-xs font-semibold text-content-primary">${inc}</span>
        </li>
      `).join('');
    }
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeIdx = parseInt(btn.getAttribute('data-curator-tab') || '0', 10);
      tabBtns.forEach((b, idx) => {
        const isSelected = idx === activeIdx;
        b.setAttribute('aria-selected', String(isSelected));
        if (isSelected) {
          b.classList.add('border-brand-gold', 'bg-brand-brown/60', 'text-brand-white');
          b.classList.remove('border-brand-brown/60', 'bg-brand-dark/50', 'text-brand-cream/85');
        } else {
          b.classList.remove('border-brand-gold', 'bg-brand-brown/60', 'text-brand-white');
          b.classList.add('border-brand-brown/60', 'bg-brand-dark/50', 'text-brand-cream/85');
        }
      });
      renderCurator();
    });
  });

  qtyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeQty = parseInt(btn.getAttribute('data-curator-qty') || '30', 10);
      qtyBtns.forEach(b => {
        const q = parseInt(b.getAttribute('data-curator-qty') || '0', 10);
        if (q === activeQty) {
          b.classList.add('bg-brand-gold', 'text-brand-dark', 'border-brand-gold');
          b.classList.remove('bg-brand-dark/60', 'text-brand-cream', 'border-brand-brown');
        } else {
          b.classList.remove('bg-brand-gold', 'text-brand-dark', 'border-brand-gold');
          b.classList.add('bg-brand-dark/60', 'text-brand-cream', 'border-brand-brown');
        }
      });
      renderCurator();
    });
  });

  addCartBtn?.addEventListener('click', () => {
    const box = initialBoxes[activeIdx] || initialBoxes[0];
    if (!box) return;
    window.dispatchEvent(new CustomEvent('add-to-cart', {
      detail: {
        id: box.id,
        name: box.name,
        price: box.price,
        unit: box.priceUnit || 'box',
        image: box.image,
        quantity: activeQty
      }
    }));
  });
</script>

<script>
  import { initClientSync } from '../utils/clientSync';

  // Run live sync with localStorage (from UMKM Admin)
  initClientSync();

  // Add to cart click event binder for product cards on homepage
  document.querySelectorAll('[data-add-to-cart]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name');
      const price = parseInt(target.getAttribute('data-price') || '0', 10);
      const unit = target.getAttribute('data-unit') || 'pcs';
      const image = target.getAttribute('data-image') || '';

      window.dispatchEvent(new CustomEvent('add-to-cart', {
        detail: { id, name, price, unit, image, quantity: 1 }
      }));
    });
  });
