---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
import { snackBoxes } from '../data/snackBoxes';
import { faqs } from '../data/faqs';
import { siteConfig } from '../data/siteConfig';
import { createGeneralInquiryUrl } from '../utils/whatsapp';

const waConsultUrl = createGeneralInquiryUrl();
---

<BaseLayout 
  title="Rasanesia | Jajanan Tradisional, Snack Box & Catering Surakarta"
  description="Katalog jajanan pasar tradisional nusantara, paket snack box acara, dan katering untuk area Kota Surakarta dan Kabupaten Sukoharjo."
  preloadHeroImage="/images/hero/hero-banner.jpg"
>

  <!-- 1. EDITORIAL HERO SECTION -->
  <header aria-labelledby="hero-heading" class="relative bg-editorial-grain bg-gradient-to-b from-surface-subtle/70 via-surface-primary to-surface-primary pt-8 pb-16 lg:pt-14 lg:pb-24 overflow-hidden border-b border-line-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Top Editorial Metadata Row -->
      <aside aria-label="Edisi katalog dan jaminan bahan" class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-line-subtle/80 text-xs">
        <p class="flex items-center gap-3 m-0">
          <span class="editorial-index">EDISI 01 / KURASI KULINER</span>
          <span class="text-content-secondary" aria-hidden="true">•</span>
          <strong class="font-semibold text-content-accent">KOTA SURAKARTA & SUKOHARJO</strong>
        </p>
        <ul class="hidden sm:flex items-center gap-4 text-content-secondary list-none m-0 p-0">
          <li>Sari Pandan Suji Asli</li>
          <li aria-hidden="true">•</li>
          <li>Santan Peras Segar</li>
          <li aria-hidden="true">•</li>
          <li>Tanpa Pengawet</li>
        </ul>
      </aside>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left Column: Copywriting & CTAs -->
        <div class="lg:col-span-6 space-y-6 text-left">
          <p class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-subtle border border-brand-gold/50 text-content-accent text-xs font-bold tracking-wider uppercase m-0">
            <span>Jajanan Tradisional</span>
            <span class="text-brand-brown/60" aria-hidden="true">•</span>
            <span>Snack Box</span>
            <span class="text-brand-brown/60" aria-hidden="true">•</span>
            <span>Catering</span>
          </p>

          <h1 id="hero-heading" class="font-serif text-4xl sm:text-5xl lg:text-[3.75rem] font-bold tracking-tight text-content-primary leading-[1.08]">
            Rasa Tradisi, <br class="hidden sm:inline" />
            <em class="text-content-accent italic font-medium">Cara Modern.</em>
          </h1>

          <p class="text-base sm:text-lg text-content-secondary max-w-xl leading-relaxed">
            Menyajikan kurasi kue basah tradisional Nusantara, paket snack box acara, dan hidangan katering higienis yang diproduksi segar sesuai jadwal acara Anda di Kota Surakarta dan Kabupaten Sukoharjo.
          </p>

          <!-- Primary CTAs -->
          <nav aria-label="Tautan aksi utama" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
            <a 
              href="/menu/"
              class="inline-flex items-center justify-center gap-2.5 bg-action-primary hover:bg-action-primary-hover text-content-inverse font-semibold px-8 min-h-[52px] rounded-full shadow-soft hover:shadow-hover transition-all duration-200 transform hover:-translate-y-0.5 text-base"
            >
              <span>Lihat Menu Jajanan</span>
              <svg class="w-4 h-4 text-brand-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a 
              href="/custom-snack/"
              class="inline-flex items-center justify-center gap-2.5 bg-surface-primary hover:bg-surface-subtle text-content-primary font-semibold px-7 min-h-[52px] rounded-full border-2 border-line-subtle hover:border-brand-brown/40 shadow-xs transition-all duration-200 text-base"
            >
              <span>Susun Custom Box</span>
              <span class="text-content-accent font-bold" aria-hidden="true">→</span>
            </a>
          </nav>

          <!-- Semantic Description List for Editorial Metrics -->
          <dl class="pt-6 grid grid-cols-3 gap-4 border-t border-line-subtle text-left m-0">
            <div>
              <dt class="text-xs text-content-secondary mt-0.5 font-medium order-2">Bahan Pilihan Alami</dt>
              <dd class="font-serif text-xl sm:text-2xl font-bold text-content-accent tabular-price m-0">100%</dd>
            </div>
            <div class="border-l border-line-subtle pl-4">
              <dt class="text-xs text-content-secondary mt-0.5 font-medium">Produksi Segar Acara</dt>
              <dd class="font-serif text-xl sm:text-2xl font-bold text-content-accent tabular-price m-0">H-2</dd>
            </div>
            <div class="border-l border-line-subtle pl-4">
              <dt class="text-xs text-content-secondary mt-0.5 font-medium">Box Kemasan Rapi</dt>
              <dd class="font-serif text-xl sm:text-2xl font-bold text-content-accent tabular-price m-0">Min 15</dd>
            </div>
          </dl>
        </div>

        <!-- Right Column: Semantic Hero Figure & Caption -->
        <div class="lg:col-span-6 relative">
          <figure class="relative mx-auto max-w-lg lg:max-w-none m-0">
            <div class="overflow-hidden rounded-3xl shadow-hover border-4 border-surface-primary bg-surface-subtle relative">
              <img 
                src="/images/hero/hero-banner.jpg" 
                alt="Sajian Kue Tradisional Rasanesia di atas Tampah dan Kotak Sajian" 
                class="w-full h-auto aspect-[1200/670] object-cover transform hover:scale-102 transition-transform duration-700"
                width="1200"
                height="670"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="absolute top-3 right-3 bg-surface-inverse/85 backdrop-blur-xs text-content-inverse-muted px-3 py-1 rounded-full font-mono text-[10px] tracking-widest uppercase">
                FIG. 01 — SAJIAN UTAMA
              </span>
            </div>

            <figcaption class="mt-4 sm:mt-0 sm:absolute sm:-bottom-5 sm:left-6 bg-surface-primary/95 backdrop-blur-md px-5 py-3.5 rounded-2xl shadow-card border border-line-subtle flex items-center gap-3.5">
              <span class="w-10 h-10 rounded-full bg-surface-subtle flex items-center justify-center text-xl shrink-0" aria-hidden="true">✨</span>
              <div>
                <strong class="text-xs font-bold text-content-primary block">Fresh Made by Order — Surakarta</strong>
                <span class="text-[11px] text-content-secondary block">Dimasak pagi hari sesuai jam pengantaran acara</span>
              </div>
            </figcaption>
          </figure>
        </div>

      </div>
    </div>
  </header>

  <!-- 2. KATEGORI UTAMA (4 Pilar Layanan) -->
  <section aria-labelledby="pillars-heading" class="py-16 lg:py-20 bg-surface-primary" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="editorial-kicker">01 / EMPAT PILAR LAYANAN</span>
          <h2 id="pillars-heading" class="font-serif text-3xl sm:text-4xl font-bold text-content-primary mt-2">
            Eksplorasi Sajian Rasanesia
          </h2>
        </div>
        <p class="text-sm text-content-secondary max-w-md m-0">
          Dari kudapan pasar satuan hingga jamuan prasmanan korporat, pilih format sajian yang paling tepat untuk tamu Anda.
        </p>
      </header>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 list-none m-0 p-0">
        {categories.map((cat, idx) => (
          <li>
            <article class="h-full">
              <a 
                href={cat.href}
                class="group h-full bg-surface-canvas/70 hover:bg-surface-primary border border-line-subtle hover:border-brand-brown/50 rounded-3xl overflow-hidden shadow-xs hover:shadow-card transition-all duration-300 flex flex-col"
              >
                <figure class="aspect-[4/3] overflow-hidden bg-surface-subtle relative m-0">
                  <img 
                    src={cat.image} 
                    alt={cat.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    width="400"
                    height="300"
                  />
                  <figcaption class="absolute top-3 left-3 bg-surface-primary/95 text-content-accent font-mono text-[11px] font-bold px-2.5 py-1 rounded-full shadow-xs">
                    0{idx + 1}
                  </figcaption>
                </figure>
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <h3 class="font-serif text-lg font-bold text-content-primary group-hover:text-content-accent transition-colors">
                        {cat.name}
                      </h3>
                      <span class="w-8 h-8 rounded-full bg-surface-subtle flex items-center justify-center text-content-accent group-hover:bg-action-primary group-hover:text-content-inverse transition-colors text-xs shrink-0" aria-hidden="true">
                        →
                      </span>
                    </div>
                    <p class="text-xs text-content-secondary leading-relaxed line-clamp-2 m-0">
                      {cat.shortDescription}
                    </p>
                  </div>
                </div>
              </a>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2B. SIGNATURE MOMENT: KURATOR KOTAK SAJIAN INTERAKTIF -->
  <section id="signature-curator" aria-labelledby="curator-heading" class="py-16 lg:py-24 bg-surface-inverse text-content-inverse-muted border-y border-brand-brown/50 relative overflow-hidden" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <header class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 gap-6 border-b border-brand-brown/60 pb-8">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-gold block mb-2 m-0">
            02 / SIMULASI INTERAKTIF • ANATOMI KOTAK SAJIAN
          </p>
          <h2 id="curator-heading" class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-content-inverse">
            Kurator Paket Acara Anda
          </h2>
        </div>
        <p class="text-sm text-brand-cream/85 max-w-md leading-relaxed m-0">
          Pilih karakter acara Anda di bawah ini untuk melihat komposisi kue basah, tipe kemasan, dan kalkulasi anggaran secara langsung.
        </p>
      </header>

      <!-- Interactive Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
        <!-- Left: Semantic Fieldsets for Occasion & Quantity -->
        <div class="lg:col-span-5 flex flex-col justify-between space-y-6 bg-brand-brown/25 border border-brand-gold/25 rounded-3xl p-6 sm:p-8">
          <fieldset class="space-y-4 border-0 p-0 m-0">
            <legend class="text-xs font-bold uppercase tracking-wider text-brand-gold block mb-3">
              Langkah 1 — Pilih Karakter Acara:
            </legend>
            <div class="space-y-2.5" role="tablist" aria-label="Pilih skenario paket snack box">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                data-curator-tab="0"
                class="curator-tab-btn w-full text-left p-4 rounded-2xl border-2 border-brand-gold bg-brand-brown/60 text-brand-white transition-all flex items-center justify-between gap-3"
              >
                <div>
                  <span class="font-mono text-[11px] text-brand-gold uppercase tracking-wider block">RAPAT & SEMINAR</span>
                  <span class="font-serif text-lg font-bold block">Paket Tradisional A</span>
                </div>
                <span class="font-serif text-base font-bold text-brand-gold tabular-price">Rp 12.500</span>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                data-curator-tab="1"
                class="curator-tab-btn w-full text-left p-4 rounded-2xl border-2 border-brand-brown/60 bg-brand-dark/50 hover:border-brand-gold/50 text-brand-cream/85 transition-all flex items-center justify-between gap-3"
              >
                <div>
                  <span class="font-mono text-[11px] text-brand-gold uppercase tracking-wider block">PENGAJIAN & SYUKURAN</span>
                  <span class="font-serif text-lg font-bold block">Paket Nusantara B</span>
                </div>
                <span class="font-serif text-base font-bold text-brand-gold tabular-price">Rp 16.000</span>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                data-curator-tab="2"
                class="curator-tab-btn w-full text-left p-4 rounded-2xl border-2 border-brand-brown/60 bg-brand-dark/50 hover:border-brand-gold/50 text-brand-cream/85 transition-all flex items-center justify-between gap-3"
              >
                <div>
                  <span class="font-mono text-[11px] text-brand-gold uppercase tracking-wider block">JAMUAN TAMU VIP</span>
                  <span class="font-serif text-lg font-bold block">Paket Istimewa C (Besek)</span>
                </div>
                <span class="font-serif text-base font-bold text-brand-gold tabular-price">Rp 22.000</span>
              </button>
            </div>
          </fieldset>

          <!-- Quantity Preset Controls -->
          <fieldset class="pt-5 border-t border-brand-brown/60 border-x-0 border-b-0 p-0 m-0 space-y-3">
            <div class="flex items-center justify-between">
              <legend id="curator-qty-label" class="text-xs font-bold uppercase tracking-wider text-brand-gold">
                Langkah 2 — Jumlah Box Acara:
              </legend>
              <output id="curator-qty-badge" class="font-mono text-xs font-bold px-2.5 py-1 rounded-full bg-brand-gold text-brand-dark tabular-price">
                30 Box
              </output>
            </div>
            <div class="grid grid-cols-4 gap-2" role="group" aria-labelledby="curator-qty-label">
              {[20, 30, 50, 100].map((q) => (
                <button
                  type="button"
                  data-curator-qty={q}
                  class={`curator-qty-btn min-h-[44px] rounded-xl font-mono text-xs font-bold border transition-all tabular-price ${
                    q === 30
                      ? 'bg-brand-gold text-brand-dark border-brand-gold'
                      : 'bg-brand-dark/60 text-brand-cream border-brand-brown hover:border-brand-gold/50'
                  }`}
                >
                  {q} Box
                </button>
              ))}
            </div>
          </fieldset>
        </div>

        <!-- Right: Semantic Live Anatomy Preview Article -->
        <article aria-live="polite" class="lg:col-span-7 bg-brand-white text-content-primary rounded-3xl p-6 sm:p-8 shadow-hover flex flex-col justify-between border-2 border-line-subtle">
          <div>
            <header class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-6 border-b border-line-subtle">
              <div>
                <p id="curator-pack-badge" class="inline-block px-3 py-1 rounded-full bg-surface-subtle text-content-accent text-xs font-bold m-0">
                  Kemasan: Kraft Box Ramah Lingkungan
                </p>
                <h3 id="curator-title" class="font-serif text-2xl sm:text-3xl font-bold text-content-primary mt-2">
                  Paket Tradisional A
                </h3>
              </div>
              <dl class="text-left sm:text-right m-0">
                <dt class="text-xs text-content-secondary block">Estimasi Total (<span id="curator-qty-inline">30</span> box):</dt>
                <dd class="m-0">
                  <output id="curator-total-price" class="font-serif text-2xl sm:text-3xl font-bold text-content-accent tabular-price">
                    Rp 375.000
                  </output>
                </dd>
              </dl>
            </header>

            <p id="curator-desc" class="text-sm text-content-secondary leading-relaxed mb-6">
              Kombinasi klasik 3 jajanan favorit tradisional (1 manis, 2 gurih) lengkap dengan air mineral, dikemas rapi untuk rapat kantor dan pertemuan komunitas.
            </p>

            <!-- Anatomy Breakdown Ordered List -->
            <section aria-labelledby="curator-composition-heading" class="mb-6">
              <h4 id="curator-composition-heading" class="text-xs font-bold uppercase tracking-wider text-brand-gold block mb-3">
                Komposisi Isian di Dalam Box:
              </h4>
              <ol id="curator-items-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none m-0 p-0">
                <li class="p-3.5 rounded-2xl bg-surface-canvas border border-line-subtle flex items-center gap-3">
                  <span class="w-7 h-7 rounded-full bg-action-primary text-content-inverse text-xs font-bold flex items-center justify-center shrink-0">1</span>
                  <span class="text-xs font-semibold text-content-primary">Lemper Ayam Suwir Spesial</span>
                </li>
                <li class="p-3.5 rounded-2xl bg-surface-canvas border border-line-subtle flex items-center gap-3">
                  <span class="w-7 h-7 rounded-full bg-action-primary text-content-inverse text-xs font-bold flex items-center justify-center shrink-0">2</span>
                  <span class="text-xs font-semibold text-content-primary">Dadar Gulung Unti Kelapa</span>
                </li>
                <li class="p-3.5 rounded-2xl bg-surface-canvas border border-line-subtle flex items-center gap-3">
                  <span class="w-7 h-7 rounded-full bg-action-primary text-content-inverse text-xs font-bold flex items-center justify-center shrink-0">3</span>
                  <span class="text-xs font-semibold text-content-primary">Pastel Sayur Telur Rebus</span>
                </li>
                <li class="p-3.5 rounded-2xl bg-surface-canvas border border-line-subtle flex items-center gap-3">
                  <span class="w-7 h-7 rounded-full bg-action-primary text-content-inverse text-xs font-bold flex items-center justify-center shrink-0">4</span>
                  <span class="text-xs font-semibold text-content-primary">Air Mineral Gelas 220ml & Tisu</span>
                </li>
              </ol>
            </section>
          </div>

          <footer class="pt-5 border-t border-line-subtle flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
            <button
              type="button"
              id="curator-add-cart-btn"
              class="flex-1 min-h-[48px] bg-action-primary hover:bg-action-primary-hover text-content-inverse font-semibold px-6 py-3 rounded-full shadow-soft transition-all text-sm flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4 text-brand-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              <span>Masukkan <span id="curator-btn-qty">30</span> Box ke Keranjang</span>
            </button>
            <a
              href="/custom-snack/"
              class="min-h-[48px] px-6 py-3 rounded-full border-2 border-line-subtle hover:border-brand-brown text-content-primary font-semibold text-sm inline-flex items-center justify-center transition-colors"
            >
              Ubah Isi Kue Custom →
            </a>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. PRODUK & PAKET UNGGULAN -->
  <section aria-labelledby="featured-packages-heading" class="py-16 lg:py-20 bg-surface-subtle/35 border-b border-line-subtle" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <header class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="editorial-kicker">03 / PILIHAN REKOMENDASI</span>
          <h2 id="featured-packages-heading" class="font-serif text-3xl sm:text-4xl font-bold text-content-primary mt-2">
            Paket Snack Box Unggulan
          </h2>
          <p class="text-sm text-content-secondary mt-1 m-0">
            Kombinasi snack box dan kue tradisional yang paling sering dipesan untuk acara di Surakarta.
          </p>
        </div>
        <a 
          href="/snack-box/" 
          class="inline-flex items-center gap-2 text-sm font-semibold text-content-accent hover:text-brand-brown-dark px-4 min-h-[44px] rounded-full border border-line-subtle bg-surface-primary hover:bg-surface-subtle transition-colors self-start sm:self-auto"
        >
          <span>Lihat Semua Paket</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </header>

      <!-- Snack Box Cards Grid (Semantic Articles) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {snackBoxes.map(item => (
          <article class="semantic-card flex flex-col justify-between group">
            <figure class="aspect-[4/3] overflow-hidden bg-surface-subtle relative m-0">
              <img 
                src={item.image} 
                alt={item.name} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="400"
                height="300"
              />
              <figcaption data-sync-snackbox-min={item.id} class="absolute top-3 right-3 bg-surface-primary/95 text-content-accent text-xs font-bold px-3 py-1 rounded-full shadow-xs tabular-price">
                Min {item.minOrder} box
              </figcaption>
            </figure>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <header>
                  <h3 class="font-serif text-lg font-bold text-content-primary line-clamp-1">
                    <a href={`/snack-box/${item.slug}/`} class="hover:text-content-accent min-h-[40px] inline-flex items-center">
                      {item.name}
                    </a>
                  </h3>
                </header>
                <p class="text-xs text-content-secondary line-clamp-2 mb-3 leading-relaxed">
                  {item.shortDescription}
                </p>

                <dl class="mb-4 m-0">
                  <dt class="sr-only">Harga Paket</dt>
                  <dd class="m-0">
                    <span data-sync-snackbox-price={item.id} class="font-serif text-xl font-bold text-content-accent tabular-price">
                      Rp {item.price.toLocaleString('id-ID')}
                    </span>
                    <span class="text-xs text-content-secondary">/{item.priceUnit}</span>
                  </dd>
                </dl>
              </div>

              <!-- Footer Action -->
              <footer>
                <button 
                  type="button"
                  data-add-to-cart
                  data-id={item.id}
                  data-name={item.name}
                  data-price={item.price}
                  data-unit={item.priceUnit}
                  data-image={item.image}
                  class="w-full min-h-[44px] bg-action-primary hover:bg-action-primary-hover text-content-inverse text-xs font-semibold py-3 rounded-full shadow-xs hover:shadow-soft transition-all duration-200 flex items-center justify-center gap-2 active:scale-98"
                >
                  <svg class="w-4 h-4 text-brand-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                  </svg>
                  <span>Tambah ke Keranjang</span>
                </button>
              </footer>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. ALASAN MEMILIH RASANESIA -->
  <section aria-labelledby="why-us-heading" class="py-20 bg-surface-primary overflow-hidden" data-reveal>
