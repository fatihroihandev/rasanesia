---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFAQs } from '../../lib/sanity';
import { createGeneralInquiryUrl } from '../../utils/whatsapp';

const faqs = await getFAQs();
const waUrl = createGeneralInquiryUrl();
---

<BaseLayout 
  title="Tanya Jawab (FAQ) | Rasanesia"
  description="Pertanyaan yang sering diajukan seputar pemesanan snack box, daya tahan kue basah, pembayaran, dan pengiriman di Surakarta & Sukoharjo."
>
  <!-- Semantic Page Header -->
  <header aria-labelledby="faq-page-heading" class="page-header-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Beranda</a></li>
          <li aria-current="page" class="breadcrumb-current">FAQ</li>
        </ol>
      </nav>
      <span class="editorial-kicker">Pusat Informasi</span>
      <h1 id="faq-page-heading" class="font-serif text-3xl sm:text-5xl font-bold text-content-primary mt-2">
        Pertanyaan yang Sering Diajukan
      </h1>
      <p class="text-sm sm:text-base text-content-secondary mt-3 max-w-2xl leading-relaxed m-0">
        Temukan jawaban cepat seputar pemesanan, minimal order, jangkauan pengantaran, dan daya tahan produk kami.
      </p>
    </div>
  </header>

  <!-- FAQ Accordion List -->
  <section aria-label="Daftar pertanyaan dan jawaban" class="py-16 bg-surface-primary">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group bg-surface-canvas/60 border border-line-subtle rounded-2xl p-5 transition-colors open:bg-surface-primary open:shadow-xs">
            <summary class="font-serif text-base sm:text-lg font-bold text-content-primary cursor-pointer list-none flex items-center justify-between gap-4 min-h-[44px]">
              <span>{faq.question}</span>
              <span class="w-9 h-9 rounded-full bg-surface-subtle flex items-center justify-center text-content-accent shrink-0 text-sm font-bold group-open:rotate-180 transition-transform duration-200" aria-hidden="true">
                ↓
              </span>
            </summary>
            <div class="pt-4 text-sm text-content-secondary leading-relaxed border-t border-line-subtle/60 mt-4">
              <p class="m-0">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Still have questions? -->
      <aside aria-labelledby="faq-more-heading" class="mt-14 text-center p-8 bg-surface-subtle/40 rounded-3xl border border-line-subtle space-y-4">
        <h2 id="faq-more-heading" class="font-serif text-xl sm:text-2xl font-bold text-content-primary">Punya Pertanyaan Lain?</h2>
        <p class="text-sm text-content-secondary max-w-md mx-auto">
          Customer service Rasanesia siap menjawab segala keraguan Anda mengenai pesanan acara.
        </p>
        <a 
          href={waUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="min-h-[48px] inline-flex items-center gap-2 bg-action-primary hover:bg-action-primary-hover text-content-inverse font-semibold px-7 py-3 rounded-full transition-colors text-sm shadow-xs"
        >
          <span>Tanya via WhatsApp</span>
        </a>
      </aside>

    </div>
  </section>
</BaseLayout>
