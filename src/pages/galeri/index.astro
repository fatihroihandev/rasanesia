---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 18 featured gallery photos
const galleryItems = [
  { id: 1, file: '/images/gallery/gallery-01.jpg', title: 'Produksi Snack Box Harian', tag: 'Snack Box' },
  { id: 2, file: '/images/gallery/gallery-02.jpg', title: 'Aneka Kue Basah Pilihan', tag: 'Jajanan' },
  { id: 3, file: '/images/gallery/gallery-03.jpg', title: 'Packing Rapi & Higienis', tag: 'Dapur' },
  { id: 4, file: '/images/gallery/gallery-04.jpg', title: 'Sajian Kue Tampah Bambu', tag: 'Tampah' },
  { id: 5, file: '/images/gallery/gallery-05.jpg', title: 'Bolu Gulung & Pastel Gurih', tag: 'Jajanan' },
  { id: 6, file: '/images/gallery/gallery-06.jpg', title: 'Sosis Solo Khas Surakarta', tag: 'Jajanan' },
  { id: 7, file: '/images/gallery/gallery-07.jpg', title: 'Kue Nona Manis Santan Pandan', tag: 'Jajanan' },
  { id: 8, file: '/images/gallery/gallery-08.jpg', title: 'Snack Box Acara Rapat Kantor', tag: 'Snack Box' },
  { id: 9, file: '/images/gallery/gallery-09.jpg', title: 'Dadar Gulung Kelapa Pandan', tag: 'Jajanan' },
  { id: 10, file: '/images/gallery/gallery-10.jpg', title: 'Lemper Ayam Daun Pisang Segar', tag: 'Jajanan' },
  { id: 11, file: '/images/gallery/gallery-11.jpg', title: 'Kue Ku Kacang Hijau Merah', tag: 'Jajanan' },
  { id: 12, file: '/images/gallery/gallery-12.jpg', title: 'Kue Lumpur Kentang Lumer', tag: 'Jajanan' },
  { id: 13, file: '/images/gallery/gallery-13.jpg', title: 'Tampah Hias Daun Pisang', tag: 'Tampah' },
  { id: 14, file: '/images/gallery/gallery-14.jpg', title: 'Pesanan Syukuran & Hajatan', tag: 'Snack Box' },
  { id: 15, file: '/images/gallery/gallery-15.jpg', title: 'Koleksi Jajanan Pasar Tradisional', tag: 'Jajanan' },
  { id: 16, file: '/images/gallery/gallery-16.jpg', title: 'Pengemasan Besek Modern', tag: 'Custom' },
  { id: 17, file: '/images/gallery/gallery-17.jpg', title: 'Konsumsi Seminar & Workshop', tag: 'Snack Box' },
  { id: 18, file: '/images/gallery/gallery-18.jpg', title: 'Detail Tekstur Kue Basah Rasanesia', tag: 'Jajanan' }
];
---

<BaseLayout 
  title="Galeri Dokumentasi Produk | Rasanesia"
  description="Dokumentasi asli produksi jajanan tradisional, penyusunan snack box, dan sajian tampah dari dapur Rasanesia di Solo & Sukoharjo."
>
  <!-- Header -->
  <section class="bg-brand-cream/40 border-b border-brand-cream-dark py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <nav class="flex justify-center items-center gap-2 text-xs text-brand-muted mb-3" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-brown">Beranda</a>
        <span>/</span>
        <span class="text-brand-brown font-semibold">Galeri</span>
      </nav>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-brand-dark">
        Galeri Dapur & Produk Kami
      </h1>
      <p class="text-sm sm:text-base text-brand-muted mt-3 max-w-2xl mx-auto">
        Kumpulan foto dokumentasi nyata proses produksi, penataan kue tampah, dan pengemasan snack box harian Rasanesia.
      </p>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {galleryItems.map(item => (
          <div class="group relative rounded-2xl overflow-hidden border border-brand-cream-dark bg-brand-cream shadow-xs hover:shadow-card transition-all duration-300">
            <div class="aspect-square overflow-hidden">
              <img 
                src={item.file} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="400"
                height="400"
              />
            </div>
            <!-- Overlay Info -->
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4 flex flex-col justify-end">
              <span class="text-[10px] uppercase font-bold tracking-wider text-brand-gold">
                {item.tag}
              </span>
              <p class="text-xs font-semibold text-brand-white leading-snug">
                {item.title}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
