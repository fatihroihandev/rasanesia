---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSnackBoxes } from '../../lib/sanity';

const snackBoxes = await getSnackBoxes();
---

<BaseLayout 
  title="Katalog Paket Snack Box | Rasanesia"
  description="Pilihan paket snack box rapat, seminar, arisan, dan syukuran dengan kemasan modern ramah lingkungan di Surakarta & Sukoharjo."
>
  <!-- Semantic Page Header -->
  <header aria-labelledby="snackbox-page-heading" class="page-header-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Beranda</a></li>
          <li aria-current="page" class="breadcrumb-current">Snack Box</li>
        </ol>
      </nav>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
        <div class="lg:col-span-7">
          <span class="editorial-kicker">KATALOG 02 / KURASI KOTAK SAJIAN</span>
          <h1 id="snackbox-page-heading" class="font-serif text-3xl sm:text-5xl font-bold text-content-primary mt-2">
            Paket Snack Box Acara
          </h1>
        </div>
        <div class="lg:col-span-5">
          <p class="text-sm sm:text-base text-content-secondary leading-relaxed m-0">
            Kombinasi jajanan favorit pilihan yang dikemas higienis, praktis, dan elegan untuk rapat kantor, seminar, pengajian, maupun syukuran di Solo Raya.
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- Catalog Section -->
  <section aria-label="Daftar paket snack box" class="py-16 bg-surface-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="snackbox-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {snackBoxes.map(item => (
          <article class="semantic-card flex flex-col justify-between group">
            <div>
              <!-- Figure & Min Order Caption -->
              <figure class="aspect-[16/10] overflow-hidden bg-surface-subtle relative m-0">
                <a href={`/snack-box/${item.slug}/`} aria-label={`Lihat detail ${item.name}`}>
                  <img 
                    src={item.image} 
                    alt={item.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    width="500"
                    height="320"
                  />
                </a>
                <figcaption data-sync-snackbox-min={item.id} class="absolute top-3 right-3 bg-surface-primary/95 text-content-accent text-xs font-bold px-3 py-1 rounded-full shadow-xs tabular-price">
                  Min {item.minOrder || 15} box
                </figcaption>
              </figure>

              <!-- Content -->
              <div class="p-6">
                <header>
                  <h2 class="font-serif text-xl font-bold text-content-primary mb-2">
                    <a href={`/snack-box/${item.slug}/`} class="hover:text-content-accent transition-colors min-h-[40px] inline-flex items-center">
                      {item.name}
                    </a>
                  </h2>
                </header>
                <p class="text-xs text-content-secondary leading-relaxed mb-4">
                  {item.description}
                </p>

                <!-- Included Snacks List -->
                {item.includes && item.includes.length > 0 && (
                  <section aria-label={`Isian ${item.name}`} class="space-y-1.5 mb-5 p-4 bg-surface-canvas rounded-2xl border border-line-subtle">
                    <h3 class="text-[11px] font-bold text-content-accent uppercase tracking-wider m-0">Isian Dalam Box:</h3>
                    <ul class="text-xs text-content-primary/90 space-y-1.5 list-none m-0 p-0">
                      {item.includes.map(inc => (
                        <li class="flex items-center gap-2">
                          <span class="text-status-success font-bold" aria-hidden="true">✓</span>
                          <span>{inc}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            </div>

            <!-- Price & Actions Footer -->
            <footer class="px-6 pb-6 pt-3 border-t border-line-subtle/60 flex items-center justify-between gap-4">
              <dl class="m-0">
                <dt class="text-[11px] text-content-secondary block">Harga per box:</dt>
                <dd class="m-0">
                  {item.price ? (
                    <span data-sync-snackbox-price={item.id} class="font-serif text-xl font-bold text-content-accent tabular-price">
                      Rp {item.price.toLocaleString('id-ID')}
                    </span>
                  ) : (
                    <span data-sync-snackbox-price={item.id} class="text-xs font-semibold text-content-accent">Tanya via WA</span>
                  )}
                </dd>
              </dl>

              <div class="flex items-center gap-2">
                <a 
                  href={`/snack-box/${item.slug}/`} 
                  class="min-h-[44px] inline-flex items-center justify-center text-xs font-semibold text-content-accent hover:bg-surface-subtle border border-line-subtle px-4 rounded-full transition-colors"
                >
                  Detail
                </a>
                {item.price ? (
                  <button 
                    type="button"
                    data-add-to-cart
                    data-id={item.id}
                    data-name={item.name}
                    data-price={item.price}
                    data-unit={item.priceUnit || 'box'}
                    data-image={item.image}
                    class="min-h-[44px] inline-flex items-center justify-center bg-action-primary hover:bg-action-primary-hover text-content-inverse text-xs font-semibold px-4 rounded-full shadow-xs hover:shadow-soft transition-all"
                  >
                    + Keranjang
                  </button>
                ) : null}
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initClientSync } from '../../utils/clientSync';

  initClientSync();

  document.querySelectorAll('[data-add-to-cart]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name');
      const price = parseInt(target.getAttribute('data-price') || '0', 10);
      const unit = target.getAttribute('data-unit') || 'box';
      const image = target.getAttribute('data-image') || '';

      window.dispatchEvent(new CustomEvent('add-to-cart', {
        detail: { id, name, price, unit, image, quantity: 1 }
      }));
    });
  });
</script>
