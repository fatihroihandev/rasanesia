---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSnackBoxBySlug } from '../../lib/sanity';
import { createSnackBoxOrderUrl } from '../../utils/whatsapp';

const { slug } = Astro.params;
const box = slug ? await getSnackBoxBySlug(slug) : undefined;

if (!box) {
  return Astro.redirect('/404/');
}

const waOrderUrl = createSnackBoxOrderUrl(
  box.name, 
  box.price ? `Rp ${box.price.toLocaleString('id-ID')} / ${box.priceUnit || 'box'}` : 'Hubungi via WhatsApp',
  box.minOrder
);
---

<BaseLayout 
  title={`${box.name} | Rasanesia`}
  description={box.description}
  image={box.image}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-brand-muted mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-brown">Beranda</a>
      <span>/</span>
      <a href="/snack-box/" class="hover:text-brand-brown">Snack Box</a>
      <span>/</span>
      <span class="text-brand-brown font-semibold truncate">{box.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Image -->
      <div class="lg:col-span-6">
        <div class="rounded-3xl overflow-hidden border-2 border-brand-cream-dark shadow-card bg-brand-cream aspect-[4/3]">
          <img 
            src={box.image} 
            alt={box.name} 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <!-- Info -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="px-3 py-1 rounded-full bg-brand-cream text-brand-brown text-xs font-semibold">
            Paket Rekomendasi Acara
          </span>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-dark mt-2">
            {box.name}
          </h1>
        </div>

        <div class="p-4 rounded-2xl bg-brand-cream/40 border border-brand-cream-dark inline-block min-w-[200px]">
          <span class="text-xs text-brand-muted block">Harga per paket:</span>
          {box.price ? (
            <div>
              <span data-sync-snackbox-price={box.id} class="font-serif text-3xl font-bold text-brand-brown">
                Rp {box.price.toLocaleString('id-ID')}
              </span>
              <span class="text-xs text-brand-muted">/{box.priceUnit || 'box'}</span>
            </div>
          ) : (
            <div class="pt-1">
              <span data-sync-snackbox-price={box.id} class="text-sm font-semibold text-brand-brown">Hubungi via WhatsApp</span>
              <span class="text-[11px] text-brand-muted block">Harga dikonfirmasi sesuai pesanan</span>
            </div>
          )}
        </div>

        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          {box.description}
        </p>

        <!-- What's included -->
        {box.includes && box.includes.length > 0 && (
          <div class="p-5 rounded-2xl bg-brand-cream-light border border-brand-cream-dark space-y-3">
            <h3 class="font-serif text-base font-bold text-brand-dark">Isian Lengkap Dalam Box:</h3>
            <ul class="space-y-2 text-sm text-brand-dark/90">
              {box.includes.map(item => (
                <li class="flex items-center gap-2">
                  <span class="w-5 h-5 rounded-full bg-brand-green/20 text-brand-green flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="pt-2 text-xs text-brand-muted border-t border-brand-cream-dark/60">
              <span>Tipe Kemasan: <strong>{box.packagingType || 'Kraft Box Ramah Lingkungan'}</strong></span>
            </div>
          </div>
        )}

        <!-- Order Information Box -->
        <div class="p-4 rounded-xl bg-brand-white border border-brand-cream-dark text-xs text-brand-dark space-y-1">
          <p>• Minimal pemesanan paket: <strong>{box.minOrder || 15} box</strong>.</p>
          <p>• Rekomendasi pemesanan minimal H-2 sebelum hari acara.</p>
          <p>• Pengiriman terjamin aman khusus area Surakarta & Sukoharjo.</p>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-brand-cream-dark">
          {box.price ? (
            <button 
              type="button"
              id="box-add-cart-btn"
              data-id={box.id}
              data-name={box.name}
              data-price={box.price}
              data-unit={box.priceUnit || 'box'}
              data-image={box.image}
              class="flex-1 bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-semibold py-3.5 px-6 rounded-full shadow-soft transition-all text-sm flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Tambah ke Keranjang</span>
            </button>
          ) : null}

          <a 
            href={waOrderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-brand-green hover:bg-brand-green-dark text-brand-white font-semibold py-3.5 px-6 rounded-full shadow-soft transition-all text-sm flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.06-1.57-.327-.992-.41-1.63-1.424-1.679-1.489-.048-.066-.405-.538-.405-1.026 0-.487.256-.728.347-.827.091-.099.198-.124.264-.124.066 0 .132.001.19.005.061.004.143-.023.223.17.083.199.282.686.307.736.025.05.041.108.008.174-.033.066-.05.107-.099.165-.05.057-.105.128-.15.172-.05.049-.102.102-.044.202.058.099.258.426.554.69.381.339.702.445.801.494.099.05.157.042.215-.025.058-.066.248-.289.314-.388.066-.099.132-.083.223-.05.091.033.578.273.677.322.099.05.165.075.19.116.025.041.025.24-.119.645z" />
            </svg>
            <span>Pesan via WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { initClientSync } from '../../utils/clientSync';

  // Run live sync with localStorage (from UMKM Admin)
  initClientSync();

  const addBtn = document.getElementById('box-add-cart-btn');
  addBtn?.addEventListener('click', () => {
    const id = addBtn.getAttribute('data-id');
    const name = addBtn.getAttribute('data-name');
    const price = parseInt(addBtn.getAttribute('data-price') || '0', 10);
    const unit = addBtn.getAttribute('data-unit') || 'box';
    const image = addBtn.getAttribute('data-image') || '';

    window.dispatchEvent(new CustomEvent('add-to-cart', {
      detail: { id, name, price, unit, image, quantity: 1 }
    }));
  });
</script>
