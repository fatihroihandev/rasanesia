---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts } from '../../lib/sanity';
import { defaultCustomSnackConfig } from '../../data/customSnackConfig';

const products = await getProducts();
---

<BaseLayout 
  title="Rancang Custom Snack Box | Rasanesia"
  description="Kombinasikan sendiri aneka jajanan tradisional dan kemasan snack box sesuai kebutuhan acara dan budget Anda di Solo & Sukoharjo."
>
  <!-- Semantic Page Header -->
  <header aria-labelledby="custom-page-heading" class="page-header-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Beranda</a></li>
          <li aria-current="page" class="breadcrumb-current">Custom Pesanan</li>
        </ol>
      </nav>
      <span class="editorial-kicker">Konfigurator Pesanan</span>
      <h1 id="custom-page-heading" class="font-serif text-3xl sm:text-5xl font-bold text-content-primary mt-2">
        Formulir Custom Snack Box
      </h1>
      <p class="text-sm sm:text-base text-content-secondary mt-3 max-w-2xl leading-relaxed m-0">
        Sesuaikan pilihan kue, kemasan, anggaran, dan tanggal kebutuhan acara Anda. Formulir ini akan menyusun ringkasan permintaan resmi untuk dikonfirmasi melalui WhatsApp Business Rasanesia.
      </p>
    </div>
  </header>

  <!-- Interactive Semantic Form Section -->
  <section aria-label="Formulir penyusunan custom snack box" class="py-16 bg-surface-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <form id="custom-snack-form" class="space-y-10 bg-surface-canvas/50 border border-line-subtle p-6 sm:p-10 rounded-3xl shadow-card">
        
        <!-- Step 1: Data Pemesan (Semantic Fieldset) -->
        <fieldset class="space-y-4 border-0 p-0 m-0">
          <legend class="flex items-center gap-3 w-full mb-2">
            <span class="w-9 h-9 rounded-xl bg-action-primary text-content-inverse font-serif font-bold flex items-center justify-center text-sm shadow-xs" aria-hidden="true">01</span>
            <span class="font-serif text-xl font-bold text-content-primary">Data Pemesan</span>
          </legend>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="customer-name" class="block text-xs font-bold text-content-primary mb-1.5">Nama Pemesan / Instansi*</label>
              <input 
                type="text" 
                id="customer-name" 
                name="customerName" 
                placeholder="Contoh: Ibu Siti / PT Sinar Solo" 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                required
              />
            </div>

            <div>
              <label for="customer-phone" class="block text-xs font-bold text-content-primary mb-1.5">Nomor WhatsApp Aktif*</label>
              <input 
                type="tel" 
                id="customer-phone" 
                name="customerPhone" 
                placeholder="Contoh: 081234567890" 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                required
              />
            </div>
          </div>
        </fieldset>

        <!-- Step 2: Pilih Kemasan (Semantic Fieldset) -->
        <fieldset class="space-y-4 pt-4 border-t border-line-subtle border-x-0 border-b-0 p-0 m-0">
          <legend class="flex items-center gap-3 w-full mb-1">
            <span class="w-9 h-9 rounded-xl bg-action-primary text-content-inverse font-serif font-bold flex items-center justify-center text-sm shadow-xs" aria-hidden="true">02</span>
            <div>
              <span class="font-serif text-xl font-bold text-content-primary block">Pilih Tipe Kemasan Box</span>
              <span class="text-xs font-normal text-content-secondary block">Pilih wadah yang sesuai dengan kesan dan anggaran acara Anda.</span>
            </div>
          </legend>
          
          <div id="custom-packaging-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {defaultCustomSnackConfig.packagingOptions.map((pack, idx) => (
              <label class={`cursor-pointer border-2 ${idx === 0 ? 'border-brand-brown' : 'border-brand-cream-dark'} rounded-2xl p-4 bg-surface-primary flex flex-col justify-between hover:border-brand-brown transition-all packaging-radio-label min-h-[110px]`}>
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <input 
                      type="radio" 
                      name="boxType" 
                      value={`${pack.name} (${pack.extraPrice > 0 ? '+Rp ' + pack.extraPrice.toLocaleString('id-ID') : 'Termasuk'})`} 
                      data-extra-price={pack.extraPrice}
                      checked={idx === 0} 
                      class="w-5 h-5 text-brand-brown focus:ring-brand-brown" 
                    />
                    <span class="text-xs font-bold text-brand-gold tabular-price">
                      {pack.extraPrice > 0 ? `+Rp ${pack.extraPrice.toLocaleString('id-ID')}` : 'Termasuk'}
                    </span>
                  </div>
                  <p class="font-bold text-sm text-content-primary mt-2 m-0">{pack.name}</p>
                </div>
                <p class="text-xs text-content-secondary mt-1 m-0">{pack.description}</p>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Step 3: Pilih Jajanan (Semantic Fieldset) -->
        <fieldset class="space-y-4 pt-4 border-t border-line-subtle border-x-0 border-b-0 p-0 m-0">
          <legend class="flex items-center gap-3 w-full mb-1">
            <span class="w-9 h-9 rounded-xl bg-action-primary text-content-inverse font-serif font-bold flex items-center justify-center text-sm shadow-xs" aria-hidden="true">03</span>
            <div>
              <span class="font-serif text-xl font-bold text-content-primary block">Pilih Varian Kue Isian</span>
              <span id="custom-snacks-rule-label" class="text-xs font-normal text-content-secondary block">
                Pilih kombinasi <strong id="label-min-snacks">{defaultCustomSnackConfig.minSnacks}</strong> hingga <strong id="label-max-snacks">{defaultCustomSnackConfig.maxSnacks}</strong> jenis jajanan favorit Anda di bawah ini.
              </span>
            </div>
          </legend>

          <div id="custom-snacks-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {products.map(product => (
              <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-line-subtle bg-surface-primary hover:border-brand-brown cursor-pointer transition-colors">
                <input 
                  type="checkbox" 
                  name="selectedSnacks" 
                  value={`${product.name} (Rp ${product.price.toLocaleString('id-ID')})`}
                  data-price={product.price}
                  data-product-id={product.id}
                  class="w-5 h-5 text-brand-brown rounded focus:ring-brand-brown"
                />
                <img 
                  src={product.image} 
                  alt={product.name} 
                  width="48"
                  height="48"
                  loading="lazy"
                  class="w-12 h-12 rounded-xl object-cover border border-line-subtle shrink-0"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-bold text-content-primary truncate m-0">{product.name}</p>
                  <p data-sync-price={product.id} class="text-xs text-content-accent font-semibold tabular-price m-0">
                    Rp {product.price.toLocaleString('id-ID')}
                  </p>
                </div>
                <span class="text-[10px] px-2.5 py-1 rounded-full bg-surface-subtle text-content-primary font-semibold">
                  {product.tasteProfile}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Step 4: Jumlah, Budget & Jadwal Acara (Semantic Fieldset) -->
        <fieldset class="space-y-4 pt-4 border-t border-line-subtle border-x-0 border-b-0 p-0 m-0">
          <legend class="flex items-center gap-3 w-full mb-2">
            <span class="w-9 h-9 rounded-xl bg-action-primary text-content-inverse font-serif font-bold flex items-center justify-center text-sm shadow-xs" aria-hidden="true">04</span>
            <span class="font-serif text-xl font-bold text-content-primary">Detail Kuantitas & Jadwal Acara</span>
          </legend>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="box-qty" class="block text-xs font-bold text-content-primary mb-1.5">
                Jumlah Box (<span id="label-min-order">Min {defaultCustomSnackConfig.minOrderBoxes}</span>)*
              </label>
              <input 
                type="number" 
                id="box-qty" 
                name="boxQty" 
                min={defaultCustomSnackConfig.minOrderBoxes} 
                value="30" 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none tabular-price font-semibold"
                required
              />
            </div>

            <div>
              <label for="budget-per-box" class="block text-xs font-bold text-content-primary mb-1.5">Target Budget / Box (Opsional)</label>
              <input 
                type="text" 
                id="budget-per-box" 
                name="budgetPerBox" 
                placeholder="Misal: Rp 15.000 / box" 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
              />
            </div>

            <div>
              <label for="event-date" class="block text-xs font-bold text-content-primary mb-1.5">Tanggal Acara*</label>
              <input 
                type="date" 
                id="event-date" 
                name="eventDate" 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="delivery-area" class="block text-xs font-bold text-content-primary mb-1.5">Metode & Lokasi Pengiriman*</label>
              <select 
                id="delivery-area" 
                name="deliveryArea" 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                required
              >
                <option value="Diantar - Kota Surakarta (Solo)">Diantar - Kota Surakarta (Solo)</option>
                <option value="Diantar - Kabupaten Sukoharjo">Diantar - Kabupaten Sukoharjo</option>
                <option value="Ambil Sendiri (Pick-Up di Dapur)">Ambil Sendiri (Pick-Up di Dapur)</option>
                <option value="Area Solo Raya Lainnya (Konfirmasi Admin)">Area Solo Raya Lainnya (Konfirmasi Admin)</option>
              </select>
            </div>

            <div>
              <label for="custom-notes" class="block text-xs font-bold text-content-primary mb-1.5">Catatan Tambahan (Opsional)</label>
              <input 
                type="text" 
                id="custom-notes" 
                name="customNotes" 
                placeholder="Misal: Tambah air mineral cup, jam 08.00 pagi, dsb." 
                class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
              />
            </div>
          </div>
          
          <p id="custom-policy-note" class="text-xs text-content-secondary italic m-0">
            * {defaultCustomSnackConfig.notes}
          </p>
        </fieldset>

        <!-- Dynamic Estimate Output & Submit Footer -->
        <footer class="p-6 rounded-2xl bg-surface-primary border-2 border-line-subtle flex flex-col sm:flex-row items-center justify-between gap-4">
          <dl class="m-0">
            <dt class="text-xs text-brand-gold uppercase font-bold tracking-wider">Estimasi Anggaran</dt>
            <dd class="m-0">
              <output for="box-qty" id="live-estimate" aria-live="polite" class="font-serif text-2xl font-bold text-content-primary mt-0.5 tabular-price block">
                Rp 0 <span class="text-xs font-sans font-normal text-content-secondary">(Pilih kue di atas)</span>
              </output>
            </dd>
          </dl>

          <button 
            type="submit" 
            class="w-full sm:w-auto min-h-[48px] bg-action-whatsapp hover:bg-action-whatsapp-hover text-content-inverse font-semibold px-8 py-3.5 rounded-full shadow-soft hover:shadow-hover transition-all flex items-center justify-center gap-2 text-sm cursor-pointer"
          >
            <span>Kirim Rincian Custom ke WhatsApp</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </footer>

      </form>

    </div>
  </section>
</BaseLayout>

<script>
  import { getStoredConfig, getStoredProducts, getStoredCustomConfig } from '../../utils/store';
  import { initClientSync } from '../../utils/clientSync';

  initClientSync();

  const form = document.getElementById('custom-snack-form') as HTMLFormElement;
  const estimateEl = document.getElementById('live-estimate');
  const qtyInput = document.getElementById('box-qty') as HTMLInputElement;
  const packagingGrid = document.getElementById('custom-packaging-grid');
  const snacksGrid = document.getElementById('custom-snacks-grid');

  function hydrateCustomPage() {
    const customCfg = getStoredCustomConfig();
    const products = getStoredProducts().filter(p => p.available !== false);

    const minSnacksLabel = document.getElementById('label-min-snacks');
    const maxSnacksLabel = document.getElementById('label-max-snacks');
    const minOrderLabel = document.getElementById('label-min-order');
    const policyNote = document.getElementById('custom-policy-note');

    if (minSnacksLabel) minSnacksLabel.textContent = String(customCfg.minSnacks);
    if (maxSnacksLabel) maxSnacksLabel.textContent = String(customCfg.maxSnacks);
    if (minOrderLabel) minOrderLabel.textContent = `Min ${customCfg.minOrderBoxes}`;
    if (policyNote) policyNote.textContent = `* ${customCfg.notes}`;
    if (qtyInput) {
      qtyInput.min = String(customCfg.minOrderBoxes);
      if (parseInt(qtyInput.value, 10) < customCfg.minOrderBoxes) {
        qtyInput.value = String(customCfg.minOrderBoxes);
      }
    }

    if (packagingGrid && customCfg.packagingOptions.length > 0) {
      packagingGrid.innerHTML = customCfg.packagingOptions.map((pack, idx) => `
        <label class="cursor-pointer border-2 ${idx === 0 ? 'border-brand-brown' : 'border-brand-cream-dark'} rounded-2xl p-4 bg-surface-primary flex flex-col justify-between hover:border-brand-brown transition-all packaging-radio-label min-h-[110px]">
          <div>
            <div class="flex items-center justify-between gap-2">
              <input 
                type="radio" 
                name="boxType" 
                value="${pack.name} (${pack.extraPrice > 0 ? '+Rp ' + pack.extraPrice.toLocaleString('id-ID') : 'Termasuk'})" 
                data-extra-price="${pack.extraPrice}"
                ${idx === 0 ? 'checked' : ''} 
                class="w-5 h-5 text-brand-brown focus:ring-brand-brown" 
              />
              <span class="text-xs font-bold text-brand-gold tabular-price">
                ${pack.extraPrice > 0 ? '+Rp ' + pack.extraPrice.toLocaleString('id-ID') : 'Termasuk'}
              </span>
            </div>
            <p class="font-bold text-sm text-content-primary mt-2 m-0">${pack.name}</p>
          </div>
          <p class="text-xs text-content-secondary mt-1 m-0">${pack.description}</p>
        </label>
      `).join('');
    }

    if (snacksGrid && products.length > 0) {
      snacksGrid.innerHTML = products.map(product => `
        <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-line-subtle bg-surface-primary hover:border-brand-brown cursor-pointer transition-colors">
          <input 
            type="checkbox" 
            name="selectedSnacks" 
            value="${product.name} (Rp ${product.price.toLocaleString('id-ID')})"
            data-price="${product.price}"
            class="w-5 h-5 text-brand-brown rounded focus:ring-brand-brown"
          />
          <img 
            src="${product.image}" 
            alt="${product.name}" 
            width="48"
            height="48"
            loading="lazy"
            class="w-12 h-12 rounded-xl object-cover border border-line-subtle shrink-0"
          />
          <div class="flex-1 min-w-0">
            <p class="text-xs font-bold text-content-primary truncate m-0">${product.name}</p>
            <p class="text-xs text-content-accent font-semibold tabular-price m-0">Rp ${product.price.toLocaleString('id-ID')}</p>
          </div>
          <span class="text-[10px] px-2.5 py-1 rounded-full bg-surface-subtle text-content-primary font-semibold">
            ${product.tasteProfile}
          </span>
        </label>
      `).join('');
    }

    document.querySelectorAll('input[name="boxType"]').forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.packaging-radio-label').forEach(lbl => {
          lbl.classList.remove('border-brand-brown');
          lbl.classList.add('border-brand-cream-dark');
        });
        const parentLabel = radio.closest('.packaging-radio-label');
        parentLabel?.classList.remove('border-brand-cream-dark');
        parentLabel?.classList.add('border-brand-brown');
        updateEstimate();
      });
    });

    document.querySelectorAll('input[name="selectedSnacks"]').forEach(cb => {
      cb.addEventListener('change', updateEstimate);
    });
  }

  function updateEstimate() {
    if (!form || !estimateEl) return;
    
    const checkboxes = form.querySelectorAll('input[name="selectedSnacks"]:checked') as NodeListOf<HTMLInputElement>;
    const selectedRadio = form.querySelector('input[name="boxType"]:checked') as HTMLInputElement;
    const qty = parseInt(qtyInput?.value || '0', 10);
    
    let snackTotalPerBox = 0;
    checkboxes.forEach(cb => {
      snackTotalPerBox += parseInt(cb.getAttribute('data-price') || '0', 10);
    });

    const boxExtra = parseInt(selectedRadio?.getAttribute('data-extra-price') || '0', 10);
    const pricePerBox = snackTotalPerBox + boxExtra;
    const grandTotal = pricePerBox * (isNaN(qty) ? 0 : qty);

    if (checkboxes.length === 0) {
      estimateEl.innerHTML = `Rp 0 <span class="text-xs font-sans font-normal text-content-secondary">(Pilih minimal 1 kue)</span>`;
    } else {
      estimateEl.innerHTML = `Rp ${grandTotal.toLocaleString('id-ID')} <span class="text-xs font-sans font-normal text-content-secondary">(Rp ${pricePerBox.toLocaleString('id-ID')}/box × ${qty} box)</span>`;
    }
  }

  hydrateCustomPage();
  qtyInput?.addEventListener('input', updateEstimate);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const customerName = formData.get('customerName') as string;
    const customerPhone = formData.get('customerPhone') as string;
    const boxType = formData.get('boxType') as string;
    const selectedSnacks = formData.getAll('selectedSnacks') as string[];
    const boxQty = formData.get('boxQty') as string;
    const budgetPerBox = formData.get('budgetPerBox') as string;
    const eventDate = formData.get('eventDate') as string;
    const deliveryArea = formData.get('deliveryArea') as string;
    const customNotes = formData.get('customNotes') as string;

    if (selectedSnacks.length === 0) {
      alert('Silakan pilih minimal 1 jenis jajanan untuk isian snack box Anda.');
      return;
    }

    const snackListText = selectedSnacks.map((s, i) => `  ${i + 1}. ${s}`).join('\n');
    const estimateText = estimateEl?.textContent?.trim() || '-';

    const message = `Halo Admin *Rasanesia*, saya ingin memesan *Custom Snack Box*:\n\n` +
      `👤 *Pemesan:* ${customerName} (${customerPhone})\n` +
      `📦 *Kemasan:* ${boxType}\n` +
      `🥟 *Pilihan Kue Isian:*\n${snackListText}\n` +
      `🔢 *Jumlah Pesanan:* ${boxQty} Box\n` +
      `💰 *Target Budget/Box:* ${budgetPerBox || 'Sesuai Pilihan'}\n` +
      `📊 *Estimasi Total:* ${estimateText}\n` +
      `📅 *Tanggal Acara:* ${eventDate}\n` +
      `📍 *Pengiriman/Area:* ${deliveryArea}\n` +
      `📝 *Catatan:* ${customNotes || '-'}\n\n` +
      `Mohon konfirmasi ketersediaan slot produksi untuk jadwal tersebut. Terima kasih!`;

    const currentConfig = getStoredConfig();
    const waUrl = `https://wa.me/${currentConfig.whatsappNumber}?text=${encodeURIComponent(message)}`;
    window.open(waUrl, '_blank');
  });
</script>
