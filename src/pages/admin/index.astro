<script>
  import { 
    getAdminPin, setAdminPin,
    getStoredConfig, saveStoredConfig,
    getStoredProducts, saveStoredProducts,
    getStoredSnackBoxes, saveStoredSnackBoxes,
    getStoredCatering, saveStoredCatering,
    getStoredCustomConfig, saveStoredCustomConfig,
    resetAllToDefault,
    STORE_KEYS
  } from '../../utils/store';

  // Elements
  const authGate = document.getElementById('admin-auth-gate');
  const dashboard = document.getElementById('admin-dashboard');
  const pinForm = document.getElementById('pin-form');
  const pinInput = document.getElementById('admin-pin-input') as HTMLInputElement;
  const logoutBtn = document.getElementById('admin-logout-btn');
  const toast = document.getElementById('admin-toast');
  const toastMsg = document.getElementById('toast-message');

  function showToast(msg: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.remove('opacity-0', 'pointer-events-none');
    toast.classList.add('opacity-100');
    setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0', 'pointer-events-none');
    }, 2500);
  }

  // Client-Side Image Compression Helper (Canvas)
  function compressImage(file: File, maxWidth = 800, quality = 0.8): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (event) => {
        const img = new Image();
        img.src = event.target?.result as string;
        img.onload = () => {
          let width = img.width;
          let height = img.height;
          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            resolve(img.src);
            return;
          }
          ctx.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL('image/jpeg', quality));
        };
        img.onerror = reject;
      };
      reader.onerror = reject;
    });
  }

  // Authentication check
  function checkSession() {
    const isAuthed = sessionStorage.getItem(STORE_KEYS.ADMIN_SESSION) === 'true';
    if (isAuthed) {
      authGate?.classList.add('hidden');
      dashboard?.classList.remove('hidden');
      loadAllData();
    } else {
      authGate?.classList.remove('hidden');
      dashboard?.classList.add('hidden');
    }
  }

  pinForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const entered = pinInput?.value || '';
    const currentPin = getAdminPin();
    if (entered === currentPin) {
      sessionStorage.setItem(STORE_KEYS.ADMIN_SESSION, 'true');
      checkSession();
      showToast('Selamat datang di Panel Toko Rasanesia!');
    } else {
      alert('PIN salah. Silakan coba kembali.');
      if (pinInput) pinInput.value = '';
    }
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem(STORE_KEYS.ADMIN_SESSION);
    checkSession();
  });

  // Tab Switching
  const tabBtns = document.querySelectorAll('.admin-tab-btn');
  const tabPanes = document.querySelectorAll('.admin-tab-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-target');
      tabBtns.forEach(b => {
        b.classList.remove('bg-brand-brown', 'text-brand-white');
        b.classList.add('bg-brand-white', 'text-brand-dark');
      });
      btn.classList.add('bg-brand-brown', 'text-brand-white');
      btn.classList.remove('bg-brand-white', 'text-brand-dark');

      tabPanes.forEach(pane => {
        if (pane.id === targetId) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });
    });
  });

  // Load All Data into Tabs
  function loadAllData() {
    // 1. Config
    const cfg = getStoredConfig();
    (document.getElementById('cfg-wa-number') as HTMLInputElement).value = cfg.whatsappNumber || '';
    (document.getElementById('cfg-wa-display') as HTMLInputElement).value = cfg.whatsappDisplay || '';
    (document.getElementById('cfg-hours') as HTMLInputElement).value = cfg.operationalHours || '';
    (document.getElementById('cfg-areas') as HTMLInputElement).value = (cfg.serviceAreas || []).join(', ');
    (document.getElementById('cfg-notice') as HTMLTextAreaElement).value = cfg.addressNotice || '';

    // 2. Products
    renderAdminProducts();

    // 3. Packages
    renderAdminPackages();

    // 4. Custom Config
    renderCustomConfig();

    // 5. Catering
    renderAdminCatering();
  }

  // Save Config Tab
  document.getElementById('save-config-btn')?.addEventListener('click', () => {
    const rawNum = (document.getElementById('cfg-wa-number') as HTMLInputElement).value.replace(/[^0-9]/g, '');
    const display = (document.getElementById('cfg-wa-display') as HTMLInputElement).value;
    const hours = (document.getElementById('cfg-hours') as HTMLInputElement).value;
    const areas = (document.getElementById('cfg-areas') as HTMLInputElement).value.split(',').map(s => s.trim()).filter(Boolean);
    const notice = (document.getElementById('cfg-notice') as HTMLTextAreaElement).value;

    saveStoredConfig({
      whatsappNumber: rawNum,
      whatsappDisplay: display,
      operationalHours: hours,
      serviceAreas: areas,
      addressNotice: notice
    });
    showToast('Kontak WhatsApp & toko berhasil diperbarui!');
  });

  // ==========================================
  // TAB 2: MENU JAJANAN PASAR LOGIC
  // ==========================================
  function renderAdminProducts() {
    const container = document.getElementById('admin-product-list');
    if (!container) return;
    const products = getStoredProducts();

    container.innerHTML = products.map((p, idx) => `
      <div class="flex items-center gap-3 p-4 bg-brand-white border border-brand-cream-dark rounded-2xl shadow-2xs hover:border-brand-gold/60 transition-colors">
        <img src="${p.image}" alt="${p.name}" class="w-16 h-16 rounded-xl object-cover shrink-0 border border-brand-cream-dark" />
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <h4 class="text-xs font-bold text-brand-dark truncate">${p.name}</h4>
            <span class="text-[10px] px-2 py-0.5 rounded-full ${p.available !== false ? 'bg-brand-green/20 text-brand-green' : 'bg-red-100 text-red-700'} font-semibold">
              ${p.available !== false ? 'Tersedia' : 'Habis'}
            </span>
          </div>
          <span class="text-[10px] text-brand-muted block">${p.tasteProfile || 'Tradisional'} • Min ${p.minOrder || 15} pcs</span>
          
          <div class="flex items-center gap-2 mt-2">
            <span class="text-xs font-semibold text-brand-brown">Rp</span>
            <input 
              type="number" 
              data-product-price="${idx}" 
              value="${p.price || 0}" 
              class="w-24 text-xs font-bold p-1.5 rounded-lg border border-brand-cream-dark bg-brand-cream-light/40"
            />
            <span class="text-[11px] text-brand-muted">/${p.priceUnit || 'pcs'}</span>

            <button 
              type="button" 
              data-toggle-avail="${idx}" 
              class="text-[10px] px-2 py-1 rounded-lg border border-brand-cream-dark hover:bg-brand-cream text-brand-dark transition-colors ml-auto"
            >
              Ubah Status
            </button>
          </div>
        </div>

        <button 
          type="button" 
          data-delete-product="${idx}" 
          class="p-2 text-brand-muted hover:text-red-600 transition-colors"
          title="Hapus Jajanan"
        >
          🗑️
        </button>
      </div>
    `).join('');

    // Delete Product
    container.querySelectorAll('[data-delete-product]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-delete-product') || '0', 10);
        const prods = getStoredProducts();
        if (confirm(`Yakin ingin menghapus jajanan "${prods[idx].name}"?`)) {
          prods.splice(idx, 1);
          saveStoredProducts(prods);
          renderAdminProducts();
          showToast('Jajanan berhasil dihapus.');
        }
      });
    });

    // Toggle Availability
    container.querySelectorAll('[data-toggle-avail]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-toggle-avail') || '0', 10);
        const prods = getStoredProducts();
        prods[idx].available = prods[idx].available === false ? true : false;
        saveStoredProducts(prods);
        renderAdminProducts();
        showToast(`Status "${prods[idx].name}" diperbarui.`);
      });
    });
  }

  // Save Products Batch
  document.getElementById('save-products-btn')?.addEventListener('click', () => {
    const prods = getStoredProducts();
    const priceInputs = document.querySelectorAll('[data-product-price]');

    priceInputs.forEach(input => {
      const idx = parseInt(input.getAttribute('data-product-price') || '0', 10);
      const newPrice = parseInt((input as HTMLInputElement).value || '0', 10);
      if (prods[idx]) {
        prods[idx].price = newPrice;
      }
    });

    saveStoredProducts(prods);
    showToast('Harga seluruh kue berhasil disimpan!');
  });

  // Modal New Product (Upload Foto)
  const productModal = document.getElementById('new-product-modal');
  const npFileInput = document.getElementById('np-file-input') as HTMLInputElement;
  const npImageInput = document.getElementById('np-image') as HTMLInputElement;
