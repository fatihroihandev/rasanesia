---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Admin Kelola Toko Mandiri | Rasanesia"
  description="Dashboard mandiri pemilik UMKM Rasanesia untuk mengelola WhatsApp, harga jajanan pasar, paket snack box, custom pesanan, dan katering."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12 min-h-[80vh]">
    
    <!-- 1. LOGIN PIN GATE -->
    <div id="admin-auth-gate" class="max-w-md mx-auto bg-brand-cream-light/80 border-2 border-brand-cream-dark p-8 rounded-3xl shadow-card text-center space-y-6">
      <div class="w-16 h-16 mx-auto rounded-full bg-brand-brown text-brand-white flex items-center justify-center text-2xl shadow-sm">
        🔒
      </div>
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-brand-dark">
          Kelola Toko Rasanesia
        </h1>
        <p class="text-xs text-brand-muted mt-2 leading-relaxed">
          Masukkan PIN pengelola untuk mengupdate kontak, jajanan, paket snack box, custom, dan katering.
        </p>
      </div>

      <form id="pin-form" class="space-y-4">
        <div>
          <input 
            type="password" 
            id="admin-pin-input" 
            maxlength="8"
            placeholder="Masukkan 6 Digit PIN" 
            class="w-full text-center tracking-widest text-xl font-bold p-3.5 rounded-2xl border-2 border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
            required
            autocomplete="current-password"
          />
          <p class="text-[11px] text-brand-muted mt-2">
            PIN bawaan awal: <strong class="text-brand-brown">123456</strong>
          </p>
        </div>

        <button 
          type="submit" 
          class="w-full bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3.5 rounded-full shadow-soft transition-all text-sm active:scale-98"
        >
          Buka Dashboard Toko
        </button>
      </form>
    </div>

    <!-- 2. MAIN ADMIN DASHBOARD -->
    <div id="admin-dashboard" class="hidden space-y-6">
      
      <!-- Top Header & Actions -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 bg-brand-white border border-brand-cream-dark rounded-3xl shadow-xs">
        <div class="flex items-center gap-3">
          <img src="/images/logo.jpg" alt="Logo" class="w-12 h-12 rounded-full object-cover border border-brand-gold/60" />
          <div>
            <div class="flex items-center gap-2">
              <h1 class="font-serif text-xl sm:text-2xl font-bold text-brand-dark">
                Panel Pengelola UMKM
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-brand-green/20 text-brand-green text-[10px] font-bold">
                Online & Aktif
              </span>
            </div>
            <p class="text-xs text-brand-muted mt-0.5">
              Kelola menu, paket, kemasan custom, dan kontak WhatsApp toko secara instan.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href="/" 
            target="_blank" 
            class="px-4 py-2 text-xs font-semibold rounded-full border border-brand-cream-dark hover:bg-brand-cream text-brand-dark transition-colors flex items-center gap-1.5"
          >
            <span>Lihat Website</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <button 
            type="button" 
            id="admin-logout-btn"
            class="px-4 py-2 text-xs font-semibold rounded-full bg-brand-cream-light hover:bg-red-50 text-red-600 transition-colors"
          >
            Keluar (Kunci)
          </button>
        </div>
      </div>

      <!-- Navigation Tabs (Modern Pill Carousel) -->
      <div class="flex overflow-x-auto gap-2 pb-2 scrollbar-none border-b border-brand-cream-dark/80">
        <button 
          type="button"
          data-tab-target="tab-kontak" 
          class="admin-tab-btn px-4 py-2.5 rounded-full text-xs font-bold whitespace-nowrap bg-brand-brown text-brand-white shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>📱 Kontak & Profil</span>
        </button>
        <button 
          type="button"
          data-tab-target="tab-jajanan" 
          class="admin-tab-btn px-4 py-2.5 rounded-full text-xs font-bold whitespace-nowrap bg-brand-white text-brand-dark border border-brand-cream-dark hover:border-brand-brown shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>🥟 Menu Jajanan Pasar</span>
        </button>
        <button 
          type="button"
          data-tab-target="tab-snackbox" 
          class="admin-tab-btn px-4 py-2.5 rounded-full text-xs font-bold whitespace-nowrap bg-brand-white text-brand-dark border border-brand-cream-dark hover:border-brand-brown shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>🎁 Paket Snack Box</span>
        </button>
        <button 
          type="button"
          data-tab-target="tab-custom" 
          class="admin-tab-btn px-4 py-2.5 rounded-full text-xs font-bold whitespace-nowrap bg-brand-white text-brand-dark border border-brand-cream-dark hover:border-brand-brown shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>🍱 Custom Snack Box</span>
        </button>
        <button 
          type="button"
          data-tab-target="tab-catering" 
          class="admin-tab-btn px-4 py-2.5 rounded-full text-xs font-bold whitespace-nowrap bg-brand-white text-brand-dark border border-brand-cream-dark hover:border-brand-brown shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>🍛 Paket Catering</span>
        </button>
        <button 
          type="button"
          data-tab-target="tab-keamanan" 
          class="admin-tab-btn px-4 py-2.5 rounded-full text-xs font-bold whitespace-nowrap bg-brand-white text-brand-dark border border-brand-cream-dark hover:border-brand-brown shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>⚙️ Backup & PIN</span>
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: KONTAK WHATSAPP & TOKO -->
      <!-- ========================================== -->
      <div id="tab-kontak" class="admin-tab-pane bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-6">
        <div>
          <h2 class="font-serif text-xl font-bold text-brand-dark">Kontak WhatsApp & Pengaturan Toko</h2>
          <p class="text-xs text-brand-muted mt-1">
            Nomor ini menerima seluruh rincian pesanan dari katalog, keranjang belanja, formulir custom, dan katering.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Nomor WhatsApp Business (Angka Saja)</label>
            <div class="flex items-center">
              <span class="px-3.5 py-3 rounded-l-2xl bg-brand-cream border border-r-0 border-brand-cream-dark text-xs font-bold text-brand-brown">
                +62
              </span>
              <input 
                type="text" 
                id="cfg-wa-number" 
                placeholder="81234567890" 
                class="w-full text-sm font-semibold p-3 rounded-r-2xl border border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
              />
            </div>
            <p class="text-[11px] text-brand-muted mt-1">Contoh: Ketik <strong>81234567890</strong> (tanpa angka 0 di depan).</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Tampilan Nomor (Teks Label)</label>
            <input 
              type="text" 
              id="cfg-wa-display" 
              placeholder="+62 812-3456-7890" 
              class="w-full text-sm font-semibold p-3 rounded-2xl border border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
            />
            <p class="text-[11px] text-brand-muted mt-1">Format nomor yang terbaca di footer dan kontak pelanggan.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Jam Operasional & Saran Pemesanan</label>
            <input 
              type="text" 
              id="cfg-hours" 
              placeholder="Setiap Hari: 07.00 - 18.00 WIB (Pemesanan disarankan H-2)" 
              class="w-full text-sm p-3 rounded-2xl border border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Cakupan Wilayah Layanan</label>
            <input 
              type="text" 
              id="cfg-areas" 
              placeholder="Kota Surakarta, Kabupaten Sukoharjo" 
              class="w-full text-sm p-3 rounded-2xl border border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
            />
          </div>

          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Catatan Dapur & Kunjungan</label>
            <textarea 
              id="cfg-notice" 
              rows="2"
              class="w-full text-sm p-3 rounded-2xl border border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
            ></textarea>
          </div>
        </div>

        <div class="pt-4 border-t border-brand-cream-dark flex justify-end">
          <button 
            type="button" 
            id="save-config-btn" 
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3 px-8 rounded-full text-xs shadow-soft transition-all active:scale-98"
          >
            Simpan Perubahan Kontak Toko
          </button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: MENU JAJANAN PASAR (CRUD + UPLOAD FOTO) -->
      <!-- ========================================== -->
      <div id="tab-jajanan" class="admin-tab-pane hidden bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="font-serif text-xl font-bold text-brand-dark">Katalog Jajanan Tradisional</h2>
            <p class="text-xs text-brand-muted mt-1">
              Ubah harga kue secara instan, atur stok tersedia/habis, atau tambahkan jajanan baru dengan foto.
            </p>
          </div>
          <button 
            type="button" 
            id="open-new-product-modal"
            class="bg-brand-green hover:bg-brand-green-dark text-brand-white text-xs font-bold py-2.5 px-5 rounded-full shadow-soft transition-all flex items-center justify-center gap-2 active:scale-98"
          >
            <span>+ Tambah Jajanan Baru</span>
          </button>
        </div>

        <!-- Product List Cards -->
        <div id="admin-product-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Populated by JavaScript -->
        </div>

        <div class="pt-4 border-t border-brand-cream-dark flex justify-between items-center">
          <span class="text-xs text-brand-muted">Ketik harga baru pada kotak input lalu klik tombol simpan.</span>
          <button 
            type="button" 
            id="save-products-btn" 
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3 px-8 rounded-full text-xs shadow-soft transition-all active:scale-98"
          >
            Simpan Seluruh Harga Jajanan
          </button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 3: PAKET SNACK BOX (FULL CRUD + UPLOAD FOTO) -->
      <!-- ========================================== -->
      <div id="tab-snackbox" class="admin-tab-pane hidden bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="font-serif text-xl font-bold text-brand-dark">Paket Snack Box Acara</h2>
            <p class="text-xs text-brand-muted mt-1">
              Kelola paket siap pesan (tambah paket baru, ubah harga, ganti isian kue, minimal order, dan upload foto).
            </p>
          </div>
          <button 
            type="button" 
            id="open-new-package-modal"
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white text-xs font-bold py-2.5 px-5 rounded-full shadow-soft transition-all flex items-center justify-center gap-2 active:scale-98"
          >
            <span>+ Tambah Paket Baru</span>
          </button>
        </div>

        <!-- Package List Container -->
        <div id="admin-package-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Populated by JavaScript -->
        </div>

        <div class="pt-4 border-t border-brand-cream-dark flex justify-between items-center">
          <span class="text-xs text-brand-muted">Setiap perubahan harga & isian paket otomatis tersinkronisasi ke katalog publik.</span>
          <button 
            type="button" 
            id="save-packages-btn" 
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3 px-8 rounded-full text-xs shadow-soft transition-all active:scale-98"
          >
            Simpan Perubahan Paket
          </button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 4: CUSTOM SNACK BOX SETTINGS -->
      <!-- ========================================== -->
      <div id="tab-custom" class="admin-tab-pane hidden bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-8">
        <div>
          <h2 class="font-serif text-xl font-bold text-brand-dark">Pengaturan Custom Snack Box</h2>
          <p class="text-xs text-brand-muted mt-1">
            Atur aturan jumlah kue per box, minimal order, dan pilihan kemasan wadah yang bisa dipilih pelanggan di formulir kustom.
          </p>
        </div>

        <!-- Rules Setting -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 p-6 rounded-2xl bg-brand-cream-light/60 border border-brand-cream-dark">
          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Batas Minimal Kue per Box</label>
            <input 
              type="number" 
              id="custom-min-snacks" 
              min="1" max="10"
              class="w-full text-sm font-bold p-3 rounded-xl border border-brand-cream-dark bg-brand-white text-brand-dark"
            />
            <p class="text-[11px] text-brand-muted mt-1">Default: 2 kue.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Batas Maksimal Kue per Box</label>
            <input 
              type="number" 
              id="custom-max-snacks" 
              min="2" max="12"
              class="w-full text-sm font-bold p-3 rounded-xl border border-brand-cream-dark bg-brand-white text-brand-dark"
            />
            <p class="text-[11px] text-brand-muted mt-1">Default: 6 kue.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Minimal Pemesanan (Min Order Box)</label>
            <input 
              type="number" 
              id="custom-min-order" 
              min="5" max="500"
              class="w-full text-sm font-bold p-3 rounded-xl border border-brand-cream-dark bg-brand-white text-brand-dark"
            />
            <p class="text-[11px] text-brand-muted mt-1">Default: 20 box.</p>
          </div>

          <div class="sm:col-span-3">
            <label class="block text-xs font-bold text-brand-dark mb-1.5">Catatan / Kebijakan Custom Box</label>
            <input 
              type="text" 
              id="custom-notes" 
              class="w-full text-xs p-3 rounded-xl border border-brand-cream-dark bg-brand-white text-brand-dark"
            />
          </div>
        </div>

        <!-- Packaging Options Management -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif font-bold text-base text-brand-dark">Pilihan Kemasan & Wadah Box</h3>
            <button 
              type="button" 
              id="add-packaging-btn"
              class="text-xs font-bold text-brand-brown hover:text-brand-brown-dark bg-brand-cream px-3.5 py-1.5 rounded-full transition-colors"
            >
              + Tambah Jenis Kemasan
            </button>
          </div>

          <div id="packaging-list-container" class="space-y-3">
            <!-- Populated by JavaScript -->
          </div>
        </div>

        <div class="pt-4 border-t border-brand-cream-dark flex justify-end">
          <button 
            type="button" 
            id="save-custom-config-btn" 
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3 px-8 rounded-full text-xs shadow-soft transition-all active:scale-98"
          >
            Simpan Pengaturan Custom Box
          </button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 5: PAKET CATERING (FULL CRUD + UPLOAD FOTO) -->
      <!-- ========================================== -->
      <div id="tab-catering" class="admin-tab-pane hidden bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="font-serif text-xl font-bold text-brand-dark">Layanan & Paket Catering</h2>
            <p class="text-xs text-brand-muted mt-1">
              Kelola paket prasmanan, nasi kotak, coffee break, atau tumpeng (tambah paket baru, ubah harga per pax, minimal order, dan upload foto).
            </p>
          </div>
          <button 
            type="button" 
            id="open-new-catering-modal"
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white text-xs font-bold py-2.5 px-5 rounded-full shadow-soft transition-all flex items-center justify-center gap-2 active:scale-98"
          >
            <span>+ Tambah Paket Catering</span>
          </button>
        </div>

        <!-- Catering List Container -->
        <div id="admin-catering-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Populated by JavaScript -->
        </div>

        <div class="pt-4 border-t border-brand-cream-dark flex justify-between items-center">
          <span class="text-xs text-brand-muted">Perubahan harga per pax dan minimal porsi akan langsung tercermin di form inquiry katering.</span>
          <button 
            type="button" 
            id="save-catering-btn" 
            class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3 px-8 rounded-full text-xs shadow-soft transition-all active:scale-98"
          >
            Simpan Seluruh Paket Catering
          </button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 6: KEAMANAN & CADANGAN DATA (PIN & BACKUP) -->
      <!-- ========================================== -->
      <div id="tab-keamanan" class="admin-tab-pane hidden space-y-6">
        
        <!-- Ganti PIN -->
        <div class="bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-4">
          <h2 class="font-serif text-lg font-bold text-brand-dark">Keamanan: Ganti PIN Pengelola</h2>
          <p class="text-xs text-brand-muted">
            Ubah PIN 6-digit untuk menjaga akses panel admin dari perubahan yang tidak disengaja.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 max-w-md">
            <input 
              type="password" 
              id="new-pin-input" 
              placeholder="Ketik PIN Baru (min 4 digit)" 
              class="w-full text-sm font-bold p-3 rounded-2xl border border-brand-cream-dark bg-brand-white text-brand-dark focus:border-brand-brown outline-none"
            />
            <button 
              type="button" 
              id="save-pin-btn"
              class="bg-brand-brown hover:bg-brand-brown-dark text-brand-white font-bold py-3 px-6 rounded-2xl text-xs whitespace-nowrap"
            >
              Perbarui PIN
            </button>
          </div>
        </div>

        <!-- Cadangan JSON (Backup & Restore) -->
        <div class="bg-brand-white border border-brand-cream-dark p-6 sm:p-8 rounded-3xl shadow-card space-y-4">
          <h2 class="font-serif text-lg font-bold text-brand-dark">Cadangan & Pemulihan Data (Backup & Restore)</h2>
          <p class="text-xs text-brand-muted leading-relaxed">
            Unduh salinan seluruh konfigurasi toko, harga jajanan, snack box, custom, dan catering ke dalam file JSON di HP/laptop Anda. File ini bisa di-upload kembali kapan saja jika berganti browser atau perangkat.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <button 
              type="button" 
              id="download-backup-btn"
              class="bg-brand-green hover:bg-brand-green-dark text-brand-white font-bold py-3 px-6 rounded-full text-xs shadow-soft transition-all flex items-center justify-center gap-2"
            >
              <span>📥 Download Backup Toko (JSON)</span>
            </button>

            <label class="cursor-pointer bg-brand-cream hover:bg-brand-cream-dark text-brand-dark font-bold py-3 px-6 rounded-full text-xs transition-all flex items-center justify-center gap-2">
              <span>📤 Upload File Restore</span>
              <input type="file" id="upload-backup-file" accept=".json" class="hidden" />
            </label>
          </div>
        </div>

        <!-- Reset Bawaan Pabrik -->
        <div class="bg-red-50/60 border border-red-200 p-6 sm:p-8 rounded-3xl space-y-4">
          <h2 class="font-serif text-lg font-bold text-red-900">Setel Ulang ke Data Awal (Reset Default)</h2>
          <p class="text-xs text-red-800 leading-relaxed">
            Gunakan tombol ini jika Anda ingin mengembalikan seluruh harga, menu jajanan, snack box, custom, dan katering ke kondisi awal bawaan toko.
          </p>
          <button 
            type="button" 
            id="reset-all-btn"
            class="bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-6 rounded-full text-xs shadow-soft transition-all"
          >
            Reset Semua Data Toko
          </button>
        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- MODAL 1: TAMBAH JAJANAN BARU (+ FOTO UPLOAD) -->
    <!-- ========================================== -->
    <div id="new-product-modal" class="hidden fixed inset-0 z-50 bg-brand-dark/60 backdrop-blur-xs items-center justify-center p-4 overflow-y-auto">
      <div class="bg-brand-white rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-brand-cream-dark shadow-2xl space-y-5 my-8">
        <div class="flex items-center justify-between pb-3 border-b border-brand-cream-dark">
          <h3 class="font-serif text-xl font-bold text-brand-dark">Tambah Jajanan Baru</h3>
          <button type="button" id="close-modal-btn" class="p-2 text-brand-muted hover:text-brand-dark text-lg">✕</button>
        </div>

        <form id="new-product-form" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-brand-dark mb-1">Nama Jajanan</label>
            <input 
              type="text" 
              id="np-name" 
              required 
              placeholder="Misal: Kue Talam Pandan Asli" 
              class="w-full text-sm p-3 rounded-xl border border-brand-cream-dark bg-brand-cream-light/30 focus:border-brand-brown outline-none"
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-brand-dark mb-1">Harga Satuan (Rp)</label>
              <input 
