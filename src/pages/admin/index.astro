    const incStr = (document.getElementById('cat-includes') as HTMLTextAreaElement).value;
    const desc = (document.getElementById('cat-desc') as HTMLTextAreaElement).value.trim();
    const img = catImageInput.value.trim() || '/images/categories/catering.jpg';

    const includes = incStr.split(',').map(s => s.trim()).filter(Boolean);
    const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const pkgs = getStoredCatering();

    const categoryLabels: Record<string, string> = {
      prasmanan: 'Prasmanan Tradisional',
      nasibox: 'Nasi Kotak / Bento Box',
      coffeebreak: 'Coffee Break & Tampah',
      tumpeng: 'Tumpeng Tradisional'
    };

    if (editIndex >= 0 && pkgs[editIndex]) {
      // Update
      pkgs[editIndex] = {
        ...pkgs[editIndex],
        name,
        slug,
        category,
        categoryLabel: categoryLabels[category] || 'Catering',
        pricePerPax,
        minPax,
        includes,
        description: desc,
        image: img
      };
      showToast(`Paket katering "${name}" berhasil diperbarui!`);
    } else {
      // Create
      pkgs.unshift({
        id: `cat-custom-${Date.now()}`,
        slug,
        name,
        category,
        categoryLabel: categoryLabels[category] || 'Catering',
        pricePerPax,
        minPax,
        description: desc || 'Sajian katering lezat dan higienis untuk berbagai acara.',
        includes,
        image: img,
        isPopular: true
      });
      showToast(`Paket katering "${name}" berhasil ditambahkan!`);
    }

    saveStoredCatering(pkgs);
    renderAdminCatering();
    closeCateringModal();
  });

  // Save Catering Batch Button
  document.getElementById('save-catering-btn')?.addEventListener('click', () => {
    const pkgs = getStoredCatering();
    document.querySelectorAll('[data-cat-price]').forEach(input => {
      const idx = parseInt(input.getAttribute('data-cat-price') || '0', 10);
      const newPrice = parseInt((input as HTMLInputElement).value || '0', 10);
      if (pkgs[idx]) pkgs[idx].pricePerPax = newPrice;
    });

    document.querySelectorAll('[data-cat-min]').forEach(input => {
      const idx = parseInt(input.getAttribute('data-cat-min') || '0', 10);
      const newMin = parseInt((input as HTMLInputElement).value || '0', 10);
      if (pkgs[idx]) pkgs[idx].minPax = newMin;
    });

    document.querySelectorAll('[data-cat-includes]').forEach(input => {
      const idx = parseInt(input.getAttribute('data-cat-includes') || '0', 10);
      const incStr = (input as HTMLInputElement).value;
      if (pkgs[idx]) {
        pkgs[idx].includes = incStr.split(',').map(s => s.trim()).filter(Boolean);
      }
    });

    saveStoredCatering(pkgs);
    showToast('Paket katering berhasil disimpan!');
  });

  // ==========================================
  // TAB 6: KEAMANAN & CADANGAN (PIN & BACKUP)
  // ==========================================
  document.getElementById('save-pin-btn')?.addEventListener('click', () => {
    const newPin = (document.getElementById('new-pin-input') as HTMLInputElement).value.trim();
    if (newPin.length < 4) {
      alert('PIN minimal 4 karakter.');
      return;
    }
    setAdminPin(newPin);
    (document.getElementById('new-pin-input') as HTMLInputElement).value = '';
    showToast('PIN pengelola berhasil diubah!');
  });

  // Full Backup JSON
  document.getElementById('download-backup-btn')?.addEventListener('click', () => {
    const backupData = {
      version: '2.0',
      timestamp: new Date().toISOString(),
      config: getStoredConfig(),
      products: getStoredProducts(),
      snackBoxes: getStoredSnackBoxes(),
      catering: getStoredCatering(),
      customConfig: getStoredCustomConfig()
    };
    const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `backup-toko-rasanesia-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('File cadangan lengkap berhasil diunduh.');
  });

  // Restore JSON
  document.getElementById('upload-backup-file')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const json = JSON.parse(event.target?.result as string);
        if (json.config) saveStoredConfig(json.config);
        if (json.products) saveStoredProducts(json.products);
        if (json.snackBoxes) saveStoredSnackBoxes(json.snackBoxes);
        if (json.catering) saveStoredCatering(json.catering);
        if (json.customConfig) saveStoredCustomConfig(json.customConfig);
        loadAllData();
        showToast('Seluruh data toko berhasil dipulihkan dari cadangan!');
      } catch (err) {
        alert('File cadangan tidak valid atau rusak.');
      }
    };
    reader.readAsText(file);
  });

  // Factory Reset
  document.getElementById('reset-all-btn')?.addEventListener('click', () => {
    if (confirm('PERINGATAN: Apakah Anda yakin ingin mengembalikan seluruh harga, jajanan, snack box, custom, dan katering ke data awal pabrik?')) {
      resetAllToDefault();
      loadAllData();
      showToast('Data toko berhasil di-reset ke setelan awal.');
    }
  });

  // Initialize
  checkSession();
</script>
