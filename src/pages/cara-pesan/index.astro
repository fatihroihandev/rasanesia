---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import { createGeneralInquiryUrl } from '../../utils/whatsapp';

const waUrl = createGeneralInquiryUrl();
---

<BaseLayout 
  title="Cara Pemesanan & Alur Layanan | Rasanesia"
  description="Panduan mudah alur pemesanan jajanan dan snack box Rasanesia melalui WhatsApp Business resmi di Surakarta & Sukoharjo."
>
  <!-- Semantic Page Header -->
  <header aria-labelledby="howto-page-heading" class="page-header-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Beranda</a></li>
          <li aria-current="page" class="breadcrumb-current">Cara Pesan</li>
        </ol>
      </nav>
      <span class="editorial-kicker">Panduan Pelanggan</span>
      <h1 id="howto-page-heading" class="font-serif text-3xl sm:text-5xl font-bold text-content-primary mt-2">
        Alur Pemesanan Mudah & Transparan
      </h1>
      <p class="text-sm sm:text-base text-content-secondary mt-3 max-w-2xl leading-relaxed m-0">
        Untuk menjamin kesegaran kue basah tanpa bahan pengawet, setiap pesanan diproduksi secara khusus sesuai jadwal acara Anda.
      </p>
    </div>
  </header>

  <!-- Step by step (Semantic Ordered List) -->
  <section aria-label="Empat langkah alur pemesanan" class="py-16 bg-surface-primary">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <ol class="space-y-6 list-none m-0 p-0">
        
        <!-- Step 1 -->
        <li>
          <article class="flex flex-col sm:flex-row gap-6 p-6 sm:p-8 bg-surface-canvas/60 rounded-3xl border border-line-subtle items-start">
            <span class="w-14 h-14 rounded-2xl bg-action-primary text-content-inverse font-serif font-bold text-xl flex items-center justify-center shrink-0 shadow-xs" aria-hidden="true">
              01
            </span>
            <div class="space-y-3">
              <h2 class="font-serif text-xl sm:text-2xl font-bold text-content-primary">
                Pilih Menu atau Rancang Custom Snack Box
              </h2>
              <p class="text-sm text-content-secondary leading-relaxed m-0">
                Jelajahi katalog menu kami atau gunakan kalkulator interaktif untuk menyusun kombinasi jajanan manis dan gurih sesuai anggaran acara Anda.
              </p>
              <nav aria-label="Tautan katalog produk" class="flex flex-wrap gap-2.5 pt-1">
                <a href="/menu/" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-surface-primary border border-line-subtle hover:border-brand-brown text-xs font-bold text-content-accent transition-colors">
                  Katalog Jajanan Pasar →
                </a>
                <a href="/snack-box/" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-surface-primary border border-line-subtle hover:border-brand-brown text-xs font-bold text-content-accent transition-colors">
                  Paket Snack Box →
                </a>
                <a href="/custom-snack/" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-surface-primary border border-line-subtle hover:border-brand-brown text-xs font-bold text-content-accent transition-colors">
                  Custom Snack Box →
                </a>
              </nav>
            </div>
          </article>
        </li>

        <!-- Step 2 -->
        <li>
          <article class="flex flex-col sm:flex-row gap-6 p-6 sm:p-8 bg-surface-canvas/60 rounded-3xl border border-line-subtle items-start">
            <span class="w-14 h-14 rounded-2xl bg-action-primary text-content-inverse font-serif font-bold text-xl flex items-center justify-center shrink-0 shadow-xs" aria-hidden="true">
              02
            </span>
            <div class="space-y-2">
              <h2 class="font-serif text-xl sm:text-2xl font-bold text-content-primary">
                Lanjutkan Pesanan ke WhatsApp Business Resmi
              </h2>
              <p class="text-sm text-content-secondary leading-relaxed m-0">
                Klik tombol <em>"Lanjutkan ke WhatsApp"</em> atau <em>"Pesan Sekarang"</em>. Sistem website akan otomatis menyusun rincian produk, jumlah box, dan catatan tanggal acara Anda ke dalam pesan WhatsApp yang rapi dan siap kirim ke nomor resmi kami (<strong class="text-content-primary">{siteConfig.whatsappDisplay}</strong>).
              </p>
            </div>
          </article>
        </li>

        <!-- Step 3 -->
        <li>
          <article class="flex flex-col sm:flex-row gap-6 p-6 sm:p-8 bg-surface-canvas/60 rounded-3xl border border-line-subtle items-start">
            <span class="w-14 h-14 rounded-2xl bg-action-primary text-content-inverse font-serif font-bold text-xl flex items-center justify-center shrink-0 shadow-xs" aria-hidden="true">
              03
            </span>
            <div class="space-y-2">
              <h2 class="font-serif text-xl sm:text-2xl font-bold text-content-primary">
                Konfirmasi Ketersediaan & Pembayaran
              </h2>
              <p class="text-sm text-content-secondary leading-relaxed m-0">
                Customer service Rasanesia akan mengonfirmasi slot produksi, menghitung biaya pengantaran ke alamat Anda, dan mengirimkan invoice rincian pembayaran melalui transfer bank resmi.
              </p>
            </div>
          </article>
        </li>

        <!-- Step 4 -->
        <li>
          <article class="flex flex-col sm:flex-row gap-6 p-6 sm:p-8 bg-surface-canvas/60 rounded-3xl border border-line-subtle items-start">
            <span class="w-14 h-14 rounded-2xl bg-action-primary text-content-inverse font-serif font-bold text-xl flex items-center justify-center shrink-0 shadow-xs" aria-hidden="true">
              04
            </span>
            <div class="space-y-2">
              <h2 class="font-serif text-xl sm:text-2xl font-bold text-content-primary">
                Produksi Segar & Pengantaran Tepat Waktu
              </h2>
              <p class="text-sm text-content-secondary leading-relaxed m-0">
                Kue basah Anda dimasak di hari pengiriman, dikemas dengan standar higienis tinggi, dan diantarkan langsung ke lokasi acara Anda di wilayah Surakarta dan Sukoharjo sesuai jam yang disepakati.
              </p>
            </div>
          </article>
        </li>

      </ol>

      <!-- Quick CTA Aside -->
      <aside aria-labelledby="howto-cta-heading" class="mt-12 text-center p-8 sm:p-10 bg-surface-subtle/40 rounded-3xl border border-line-subtle space-y-4">
        <h2 id="howto-cta-heading" class="font-serif text-2xl font-bold text-content-primary">Ada Pertanyaan Khusus?</h2>
        <p class="text-sm text-content-secondary max-w-lg mx-auto">
          Tim kami senang membantu Anda merencanakan konsumsi terbaik untuk kegiatan Anda.
        </p>
        <a 
          href={waUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="min-h-[48px] inline-flex items-center gap-2 bg-action-whatsapp hover:bg-action-whatsapp-hover text-content-inverse font-semibold px-8 py-3.5 rounded-full shadow-soft transition-all text-sm"
        >
          <span>Chat WhatsApp Sekarang</span>
        </a>
      </aside>

    </div>
  </section>
</BaseLayout>
