---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultCateringPackages } from '../../data/catering';
---

<BaseLayout 
  title="Layanan Catering Nusantara | Rasanesia"
  description="Layanan katering prasmanan, nasi kotak nusantara, dan coffee break jajanan pasar untuk seminar, gathering, dan pesta di Solo & Sukoharjo."
>
  <!-- Semantic Page Header -->
  <header aria-labelledby="catering-page-heading" class="page-header-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Beranda</a></li>
          <li aria-current="page" class="breadcrumb-current">Catering</li>
        </ol>
      </nav>
      <span class="editorial-kicker">Sajian Prasmanan & Nasi Kotak</span>
      <h1 id="catering-page-heading" class="font-serif text-3xl sm:text-5xl font-bold text-content-primary mt-2">
        Layanan Catering Nusantara
      </h1>
      <p class="text-sm sm:text-base text-content-secondary mt-3 max-w-2xl leading-relaxed m-0">
        Kelezatan hidangan otentik Indonesia dengan presentasi prasmanan bersih, higienis, dan terpercaya untuk berbagai skala acara di Solo Raya.
      </p>
    </div>
  </header>

  <!-- Catering Options Grid & Inquiry Section -->
  <section aria-label="Katalog layanan catering dan formulir penawaran" class="py-16 bg-surface-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div id="catering-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {defaultCateringPackages.map((pkg, idx) => (
          <article class="semantic-card bg-surface-canvas/60 flex flex-col justify-between">
            <div>
              <figure class="aspect-[16/10] overflow-hidden bg-surface-subtle relative m-0">
                <img 
                  src={pkg.image} 
                  alt={pkg.name} 
                  width="600"
                  height="375"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading={idx < 3 ? "eager" : "lazy"}
                />
                <figcaption data-sync-catering-min={pkg.id} class="absolute top-3 right-3 bg-surface-primary/95 text-content-accent text-xs font-bold px-3 py-1 rounded-full shadow-xs border border-line-subtle">
                  Min {pkg.minPax} pax
                </figcaption>
              </figure>
              <div class="p-6">
                <header>
                  <p class="px-3 py-1 rounded-full bg-brand-brown/10 text-content-accent text-xs font-semibold inline-block m-0">
                    {pkg.categoryLabel}
                  </p>
                  <h2 class="font-serif text-2xl font-bold text-content-primary mt-2 mb-2">
                    {pkg.name}
                  </h2>
                </header>
                <dl class="mb-3 m-0">
                  <dt class="text-[11px] text-content-secondary block">Mulai dari:</dt>
                  <dd class="m-0">
                    <span data-sync-catering-price={pkg.id} class="font-serif text-2xl font-bold text-content-accent tabular-price">
                      Rp {pkg.pricePerPax.toLocaleString('id-ID')}
                    </span>
                    <span class="text-xs text-content-secondary"> / pax</span>
                  </dd>
                </dl>
                <p class="text-xs sm:text-sm text-content-secondary leading-relaxed mb-4">
                  {pkg.description}
                </p>
                
                {pkg.includes && pkg.includes.length > 0 && (
                  <section aria-label={`Rincian menu ${pkg.name}`} class="p-4 bg-surface-primary rounded-2xl border border-line-subtle/60 space-y-1.5 mb-4">
                    <h3 class="text-[11px] font-bold text-brand-gold uppercase tracking-wider block mb-1 m-0">Rincian Menu:</h3>
                    <ul class="space-y-1 text-xs text-content-primary/90 list-none m-0 p-0">
                      {pkg.includes.map(item => (
                        <li class="flex items-start gap-2">
                          <span class="text-status-success font-bold shrink-0" aria-hidden="true">✓</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            </div>

            <footer class="p-6 pt-0">
              <a 
                href="#catering-inquiry-form" 
                data-select-catering={pkg.name}
                class="min-h-[44px] flex items-center justify-center w-full py-3 rounded-full text-center bg-action-primary hover:bg-action-primary-hover text-content-inverse font-semibold text-xs shadow-soft transition-colors"
              >
                Ajukan Penawaran Paket Ini
              </a>
            </footer>
          </article>
        ))}
      </div>

      <!-- Structured Catering Inquiry Form -->
      <section id="catering-inquiry-form" aria-labelledby="catering-inquiry-heading" class="max-w-4xl mx-auto scroll-mt-24">
        <div class="bg-surface-subtle/40 border-2 border-line-subtle rounded-3xl p-6 sm:p-10 shadow-card">
          <header class="text-center max-w-2xl mx-auto mb-8">
            <span class="editorial-kicker justify-center">Formulir Permintaan Penawaran</span>
            <h2 id="catering-inquiry-heading" class="font-serif text-2xl sm:text-3xl font-bold text-content-primary mt-2">
              Konsultasi & Penawaran Catering
            </h2>
            <p class="text-xs sm:text-sm text-content-secondary mt-2 m-0">
              Isi detail acara Anda di bawah ini. Tim katering Rasanesia akan menyusun rincian menu dan penawaran harga terbaik via WhatsApp.
            </p>
          </header>

          <form id="catering-wa-form" class="space-y-6">
            <fieldset class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-0 p-0 m-0">
              <legend class="sr-only">Identitas Pemesan</legend>
              <div>
                <label for="cat-name-input" class="block text-xs font-bold text-content-primary mb-1.5">Nama Pemesan / Instansi*</label>
                <input 
                  type="text" 
                  id="cat-name-input" 
                  name="customerName" 
                  placeholder="Contoh: Bapak Budi / Dinas Pendidikan" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                  required
                />
              </div>

              <div>
                <label for="cat-phone-input" class="block text-xs font-bold text-content-primary mb-1.5">Nomor WhatsApp Aktif*</label>
                <input 
                  type="tel" 
                  id="cat-phone-input" 
                  name="customerPhone" 
                  placeholder="Contoh: 081234567890" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                  required
                />
              </div>
            </fieldset>

            <fieldset class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-0 p-0 m-0">
              <legend class="sr-only">Spesifikasi Acara & Jumlah Tamu</legend>
              <div>
                <label for="cat-event-type" class="block text-xs font-bold text-content-primary mb-1.5">Jenis Acara / Paket*</label>
                <select 
                  id="cat-event-type" 
                  name="eventType" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                  required
                >
                  {defaultCateringPackages.map(pkg => (
                    <option value={`${pkg.name} (Rp ${pkg.pricePerPax.toLocaleString('id-ID')}/pax)`}>
                      {pkg.name}
                    </option>
                  ))}
                  <option value="Acara Khusus / Kombinasi Menu">Acara Khusus / Kombinasi Menu</option>
                </select>
              </div>

              <div>
                <label for="cat-pax" class="block text-xs font-bold text-content-primary mb-1.5">Estimasi Jumlah Tamu (Pax)*</label>
                <input 
                  type="number" 
                  id="cat-pax" 
                  name="paxCount" 
                  min="15" 
                  placeholder="Misal: 100" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none tabular-price font-semibold"
                  required
                />
              </div>

              <div>
                <label for="cat-date" class="block text-xs font-bold text-content-primary mb-1.5">Tanggal Acara*</label>
                <input 
                  type="date" 
                  id="cat-date" 
                  name="eventDate" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                  required
                />
              </div>
            </fieldset>

            <fieldset class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-0 p-0 m-0">
              <legend class="sr-only">Lokasi & Preferensi Menu</legend>
              <div>
                <label for="cat-location" class="block text-xs font-bold text-content-primary mb-1.5">Lokasi Acara (Kecamatan / Gedung)*</label>
                <input 
                  type="text" 
                  id="cat-location" 
                  name="eventLocation" 
                  placeholder="Contoh: Laweyan, Solo / Grogol, Sukoharjo" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                  required
                />
              </div>

              <div>
                <label for="cat-notes" class="block text-xs font-bold text-content-primary mb-1.5">Preferensi Menu / Catatan Anggaran</label>
                <input 
                  type="text" 
                  id="cat-notes" 
                  name="notes" 
                  placeholder="Misal: Budget Rp 35.000/pax, menu ayam bakar & selat solo" 
                  class="w-full min-h-[48px] text-sm p-3.5 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown outline-none"
                />
              </div>
            </fieldset>

            <footer class="pt-2 text-center">
              <button 
                type="submit" 
                class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 bg-action-whatsapp hover:bg-action-whatsapp-hover text-content-inverse font-semibold px-9 py-4 rounded-full shadow-soft hover:shadow-hover transition-all text-sm cursor-pointer"
              >
                <span>Kirim Permintaan Penawaran via WhatsApp</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </footer>
          </form>
        </div>
      </section>

    </div>
  </section>
</BaseLayout>

<script>
  import { getStoredConfig, getStoredCatering } from '../../utils/store';
  import { initClientSync } from '../../utils/clientSync';

  initClientSync();

  const catForm = document.getElementById('catering-wa-form') as HTMLFormElement;
  const selectDropdown = document.getElementById('cat-event-type') as HTMLSelectElement;

  function syncCateringSelect() {
    const packages = getStoredCatering();
    if (selectDropdown && packages.length > 0) {
      selectDropdown.innerHTML = packages.map(pkg => `
        <option value="${pkg.name} (Rp ${pkg.pricePerPax.toLocaleString('id-ID')}/pax)">
          ${pkg.name} — Rp ${pkg.pricePerPax.toLocaleString('id-ID')}/pax
        </option>
      `).join('') + `<option value="Acara Khusus / Kombinasi Menu">Acara Khusus / Kombinasi Menu</option>`;
    }

    document.querySelectorAll('[data-select-catering]').forEach(btn => {
      btn.addEventListener('click', () => {
        const pkgName = btn.getAttribute('data-select-catering');
        if (selectDropdown && pkgName) {
          for (let i = 0; i < selectDropdown.options.length; i++) {
            if (selectDropdown.options[i].value.includes(pkgName)) {
              selectDropdown.selectedIndex = i;
              break;
            }
          }
        }
      });
    });
  }

  syncCateringSelect();

  catForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(catForm);
    const customerName = formData.get('customerName') as string;
    const customerPhone = formData.get('customerPhone') as string;
    const eventType = formData.get('eventType') as string;
    const paxCount = formData.get('paxCount') as string;
    const eventDate = formData.get('eventDate') as string;
    const eventLocation = formData.get('eventLocation') as string;
    const notes = formData.get('notes') as string;

    const message = `Halo Admin *Rasanesia*, saya ingin meminta penawaran *Layanan Catering*:\n\n` +
      `👤 *Pemesan:* ${customerName} (${customerPhone})\n` +
      `🎉 *Paket / Jenis Acara:* ${eventType}\n` +
      `👥 *Estimasi Tamu:* ${paxCount} Pax\n` +
      `📅 *Tanggal Acara:* ${eventDate}\n` +
      `📍 *Lokasi Acara:* ${eventLocation}\n` +
      `📝 *Preferensi Menu / Catatan:* ${notes || '-'}\n\n` +
      `Mohon informasi rekomendasi paket dan rincian harganya. Terima kasih!`;

    const currentConfig = getStoredConfig();
    const waUrl = `https://wa.me/${currentConfig.whatsappNumber}?text=${encodeURIComponent(message)}`;
    window.open(waUrl, '_blank');
  });
</script>
