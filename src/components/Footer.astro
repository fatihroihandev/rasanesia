---
import { siteConfig } from '../data/siteConfig';
import { createGeneralInquiryUrl } from '../utils/whatsapp';

const waUrl = createGeneralInquiryUrl();
const currentYear = new Date().getFullYear();
---

<footer role="contentinfo" class="bg-surface-inverse text-content-inverse-muted border-t border-brand-brown/60 relative overflow-hidden">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 relative z-10">
    <!-- Top Editorial CTA Banner -->
    <section aria-labelledby="footer-editorial-heading" class="pb-12 mb-12 border-b border-brand-brown/50 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-gold m-0">PUSAKA KULINER NUSANTARA • SURAKARTA</p>
        <h2 id="footer-editorial-heading" class="font-serif text-2xl sm:text-3xl font-bold text-content-inverse leading-snug">
          Merawat kehangatan jajanan pasar tradisional dengan presisi higienitas & kemasan masa kini.
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a 
          href="/custom-snack/"
          class="inline-flex items-center justify-center px-6 min-h-[44px] rounded-full border border-brand-gold/50 text-brand-gold hover:bg-brand-gold hover:text-brand-dark font-semibold text-xs uppercase tracking-wider transition-colors"
        >
          Susun Snack Box Custom
        </a>
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 min-h-[44px] rounded-full bg-brand-gold hover:bg-brand-gold-light text-brand-dark font-bold text-xs uppercase tracking-wider transition-colors shadow-soft"
        >
          <span>Konsultasi WhatsApp</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      
      <!-- Col 1: Brand Identity (4 cols) -->
      <section aria-labelledby="footer-brand-heading" class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3.5">
          <figure class="m-0 shrink-0">
            <img 
              src="/images/logo.jpg" 
              alt="Logo Rasanesia" 
              class="w-12 h-12 rounded-full object-cover border border-brand-gold/60"
              width="48"
              height="48"
              loading="lazy"
            />
          </figure>
          <div>
            <h2 id="footer-brand-heading" class="font-serif text-2xl font-bold tracking-tight text-content-inverse">
              {siteConfig.brandName}
            </h2>
            <p class="text-[10px] uppercase tracking-[0.16em] text-brand-gold font-semibold">
              {siteConfig.tagline}
            </p>
          </div>
        </div>
        <p class="text-sm text-brand-cream/85 leading-relaxed max-w-sm">
          {siteConfig.description}
        </p>
        <p class="pt-1 m-0">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-brand-brown/50 text-brand-gold text-xs font-medium rounded-full border border-brand-gold/30">
            <span aria-hidden="true">📍</span>
            <span>Wilayah Layanan: Kota Surakarta & Sukoharjo</span>
          </span>
        </p>
      </section>

      <!-- Col 2: Navigation Links (2 cols) -->
      <nav aria-labelledby="footer-catalog-heading" class="lg:col-span-2">
        <h2 id="footer-catalog-heading" class="font-serif text-base font-bold text-content-inverse mb-3 tracking-tight">Katalog & Layanan</h2>
        <ul class="space-y-1 text-sm text-brand-cream/85 list-none m-0 p-0">
          {siteConfig.mainNavLinks.map(link => (
            <li>
              <a href={link.href} class="min-h-[40px] inline-flex items-center hover:text-brand-gold transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Col 3: Secondary Information Links (3 cols) -->
      <nav aria-labelledby="footer-info-heading" class="lg:col-span-3">
        <h2 id="footer-info-heading" class="font-serif text-base font-bold text-content-inverse mb-3 tracking-tight">Informasi Pelanggan</h2>
        <ul class="grid grid-cols-1 gap-1 text-sm text-brand-cream/85 mb-4 list-none m-0 p-0">
          {siteConfig.secondaryNavLinks.map(link => (
            <li>
              <a href={link.href} class="min-h-[40px] inline-flex items-center hover:text-brand-gold transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Col 4: Semantic Address & Operational Metadata (3 cols) -->
      <section aria-labelledby="footer-hours-heading" class="lg:col-span-3 space-y-4">
        <h2 id="footer-hours-heading" class="font-serif text-base font-bold text-content-inverse tracking-tight">Dapur & Jam Layanan</h2>
        <address class="not-italic space-y-4">
          <dl class="space-y-4 m-0">
            <div class="p-4 rounded-2xl bg-brand-brown/35 border border-brand-gold/25 text-xs text-brand-cream/90 space-y-1.5">
              <dt class="font-semibold text-brand-gold">Jam Operasional:</dt>
              <dd id="footer-operational-hours" class="leading-relaxed m-0">
                <time>{siteConfig.operationalHours}</time>
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-brand-brown/35 border border-brand-gold/25 text-xs text-brand-cream/85 space-y-1.5">
              <dt class="font-semibold text-brand-gold">Catatan Kunjungan Dapur:</dt>
              <dd class="leading-relaxed m-0">{siteConfig.addressNotice}</dd>
            </div>
          </dl>
        </address>
      </section>

    </div>

    <!-- Bottom Legal & Admin Bar -->
    <div class="mt-12 pt-8 border-t border-brand-brown/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-brand-cream/80">
      <p class="m-0"><small class="text-xs">© {currentYear} {siteConfig.brandName} Surakarta. Semua hak dilindungi.</small></p>
      
      <nav aria-label="Tautan kebijakan dan pengelola toko">
        <ul class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 list-none m-0 p-0">
          <li>
            <a href="/ketentuan-pemesanan/" class="min-h-[40px] inline-flex items-center px-2 hover:text-brand-gold transition-colors">Ketentuan Pemesanan</a>
          </li>
          <li aria-hidden="true" class="text-brand-cream/40 select-none">•</li>
          <li>
            <a href="/kebijakan-privasi/" class="min-h-[40px] inline-flex items-center px-2 hover:text-brand-gold transition-colors">Kebijakan Privasi</a>
          </li>
          <li aria-hidden="true" class="text-brand-cream/40 select-none">•</li>
          <li>
            <!-- Tautan khusus pengelola UMKM -->
            <a href="/admin/" class="min-h-[40px] inline-flex items-center gap-1.5 px-3 rounded-full bg-brand-brown/40 hover:bg-brand-brown/70 transition-colors font-semibold text-brand-gold">
              <span aria-hidden="true">⚙️</span>
              <span>Kelola Toko</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
