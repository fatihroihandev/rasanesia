---
import { siteConfig } from '../data/siteConfig';
---

<!-- Semantic Slide-Over Cart Drawer -->
<aside 
  id="cart-drawer-root" 
  aria-label="Panel keranjang pesanan"
  class="fixed inset-0 z-50 pointer-events-none invisible transition-all duration-300 opacity-0"
  aria-hidden="true"
>
  <!-- Backdrop Overlay -->
  <div 
    id="cart-backdrop" 
    class="absolute inset-0 bg-brand-dark/60 backdrop-blur-xs cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Slide-out Dialog Panel -->
  <div 
    id="cart-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
    class="absolute top-0 right-0 h-full w-full max-w-md bg-surface-primary shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out border-l border-line-subtle pointer-events-auto"
  >
    <!-- Drawer Header -->
    <header class="p-5 border-b border-line-subtle flex items-center justify-between bg-surface-subtle/50">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-full bg-brand-brown/10 text-content-accent flex items-center justify-center" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </span>
        <div>
          <h2 id="cart-drawer-title" class="font-serif text-xl font-bold text-content-primary leading-tight">Keranjang Pesanan</h2>
          <p class="text-[11px] text-content-secondary">Diteruskan langsung ke WhatsApp resmi</p>
        </div>
      </div>
      <button 
        id="cart-close-btn" 
        type="button" 
        class="min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-full text-content-secondary hover:bg-surface-subtle hover:text-content-primary transition-colors"
        aria-label="Tutup Keranjang"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    <!-- Items List Body -->
    <section id="cart-items-container" aria-label="Daftar produk di keranjang" class="flex-1 overflow-y-auto p-5 space-y-3.5" aria-live="polite">
      <!-- Items dynamically populated via JavaScript -->
    </section>

    <!-- Empty State (Shown when 0 items) -->
    <section id="cart-empty-state" aria-label="Status keranjang kosong" class="hidden flex-1 flex flex-col items-center justify-center p-6 text-center">
      <div class="w-20 h-20 bg-surface-subtle rounded-full flex items-center justify-center mb-4 text-content-accent" aria-hidden="true">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <h3 class="font-serif text-lg font-bold text-content-primary mb-1">Keranjang Masih Kosong</h3>
      <p class="text-sm text-content-secondary mb-6 max-w-xs leading-relaxed">
        Pilih jajanan tradisional atau paket snack box favorit Anda dan tambahkan ke daftar pesanan ini.
      </p>
      <a 
        href="/menu/" 
        id="cart-explore-btn"
        class="bg-action-primary hover:bg-action-primary-hover text-content-inverse text-sm font-semibold px-6 min-h-[44px] inline-flex items-center justify-center rounded-full transition-colors"
      >
        Jelajahi Katalog Jajanan
      </a>
    </section>

    <!-- Footer Summary & WhatsApp Checkout -->
    <footer id="cart-footer" class="p-5 border-t border-line-subtle bg-surface-subtle/35 space-y-4 safe-bottom">
      <!-- Order Notes / Event Date Input -->
      <div>
        <label for="cart-notes" class="block text-xs font-bold text-content-primary mb-1.5">
          Catatan Tambahan / Tanggal Acara (Opsional):
        </label>
        <textarea 
          id="cart-notes" 
          rows="2" 
          placeholder="Contoh: Acara rapat tgl 28 Okt, dikirim jam 09.00 pagi ke Solo Baru..."
          class="w-full text-xs p-3 rounded-xl border border-line-subtle bg-surface-primary text-content-primary focus:ring-2 focus:ring-brand-brown focus:border-transparent outline-none resize-none"
        ></textarea>
      </div>

      <!-- Subtotal -->
      <dl class="flex items-center justify-between pt-2 border-t border-line-subtle/60 m-0">
        <dt class="text-sm font-medium text-content-secondary">Subtotal Estimasi:</dt>
        <dd class="m-0">
          <output id="cart-subtotal" aria-live="polite" class="font-serif text-xl font-bold text-content-accent tabular-price">
            Rp 0
          </output>
        </dd>
      </dl>

      <!-- Checkout WhatsApp Button -->
      <button 
        id="cart-checkout-btn" 
        type="button" 
        class="w-full min-h-[48px] flex items-center justify-center gap-2 bg-action-whatsapp hover:bg-action-whatsapp-hover text-content-inverse font-semibold py-3.5 rounded-full shadow-soft hover:shadow-hover transition-all text-sm transform hover:-translate-y-0.5"
      >
        <span>Lanjutkan ke WhatsApp</span>
        <svg class="w-5 h-5 text-brand-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
      </button>

      <p class="text-[11px] text-center text-content-secondary">
        Konfirmasi ketersediaan & ongkir akan dilayani langsung via chat WhatsApp.
      </p>
    </footer>
  </div>
</aside>

<script define:vars={{ whatsappNumber: siteConfig.whatsappNumber }}>
  const CART_KEY = 'rasanesia_cart_items';

  function getCart() {
    try {
      const stored = localStorage.getItem(CART_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch (e) {
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
      updateBadge();
      renderCartItems();
    } catch (e) {
      console.error('Failed to save cart:', e);
    }
  }

  function updateBadge() {
    const cart = getCart();
    const count = cart.reduce((acc, item) => acc + item.quantity, 0);
    const badges = [
      document.getElementById('cart-badge'),
      document.getElementById('cart-badge-mobile')
    ];

    badges.forEach(b => {
      if (!b) return;
      if (count > 0) {
        b.textContent = String(count > 99 ? '99+' : count);
        b.classList.remove('hidden');
        b.classList.add('flex');
      } else {
        b.classList.add('hidden');
        b.classList.remove('flex');
      }
    });
  }

  function renderCartItems() {
    const cart = getCart();
    const container = document.getElementById('cart-items-container');
    const emptyState = document.getElementById('cart-empty-state');
    const footer = document.getElementById('cart-footer');
    const subtotalEl = document.getElementById('cart-subtotal');

    if (!container || !emptyState || !footer || !subtotalEl) return;

    if (cart.length === 0) {
      container.innerHTML = '';
      container.classList.add('hidden');
      emptyState.classList.remove('hidden');
      footer.classList.add('hidden');
      return;
    }

    container.classList.remove('hidden');
    emptyState.classList.add('hidden');
    footer.classList.remove('hidden');

    let subtotal = 0;
    container.innerHTML = cart.map((item, index) => {
      const itemSubtotal = item.price * item.quantity;
      subtotal += itemSubtotal;
      return `
        <article class="flex items-center gap-3 p-3.5 bg-surface-primary border border-line-subtle rounded-2xl shadow-xs">
          ${item.image ? `
            <figure class="m-0 shrink-0">
              <img 
                src="${item.image}" 
                alt="${item.name}" 
                width="64"
                height="64"
                class="w-16 h-16 rounded-xl object-cover border border-line-subtle" 
              />
            </figure>
          ` : `
            <div class="w-16 h-16 rounded-xl bg-surface-subtle flex items-center justify-center shrink-0 text-content-accent" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </div>
          `}
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-semibold text-content-primary truncate">${item.name}</h3>
            <p class="text-xs text-content-secondary tabular-price">Rp ${item.price.toLocaleString('id-ID')} / ${item.unit || 'pcs'}</p>
            <div class="flex items-center justify-between gap-2 mt-2">
              <div class="inline-flex items-center border border-line-subtle rounded-full bg-surface-canvas p-0.5" role="group" aria-label="Atur jumlah ${item.name}">
                <button 
                  type="button" 
                  data-cart-action="decrement" 
                  data-index="${index}" 
                  aria-label="Kurangi jumlah ${item.name}"
                  class="w-8 h-8 flex items-center justify-center text-sm font-bold text-content-primary hover:bg-surface-subtle rounded-full transition-colors"
                >−</button>
                <output class="w-8 text-center text-xs font-bold text-content-primary tabular-price">${item.quantity}</output>
                <button 
                  type="button" 
                  data-cart-action="increment" 
                  data-index="${index}" 
                  aria-label="Tambah jumlah ${item.name}"
                  class="w-8 h-8 flex items-center justify-center text-sm font-bold text-content-primary hover:bg-surface-subtle rounded-full transition-colors"
                >+</button>
              </div>
              <output class="text-xs font-bold text-content-accent tabular-price">Rp ${itemSubtotal.toLocaleString('id-ID')}</output>
            </div>
          </div>
          <button 
            type="button" 
            data-cart-action="remove" 
            data-index="${index}" 
            class="w-10 h-10 inline-flex items-center justify-center text-content-secondary hover:text-status-danger hover:bg-red-50 transition-colors rounded-full shrink-0"
            aria-label="Hapus ${item.name} dari keranjang"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </article>
      `;
    }).join('');

    subtotalEl.textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;

    container.querySelectorAll('[data-cart-action]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const action = target.getAttribute('data-cart-action');
        const index = parseInt(target.getAttribute('data-index') || '0', 10);
        const currentCart = getCart();

        if (action === 'increment') {
          currentCart[index].quantity += 1;
        } else if (action === 'decrement') {
          if (currentCart[index].quantity > 1) {
            currentCart[index].quantity -= 1;
          } else {
            currentCart.splice(index, 1);
          }
        } else if (action === 'remove') {
          currentCart.splice(index, 1);
        }

        saveCart(currentCart);
      });
    });
  }

  const root = document.getElementById('cart-drawer-root');
  const panel = document.getElementById('cart-panel');
  const backdrop = document.getElementById('cart-backdrop');
  const closeBtn = document.getElementById('cart-close-btn');
  const exploreBtn = document.getElementById('cart-explore-btn');

  function openCart() {
    renderCartItems();
    if (!root || !panel) return;
    root.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
    root.classList.add('opacity-100');
    root.setAttribute('aria-hidden', 'false');
    panel.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeCart() {
    if (!root || !panel) return;
    panel.classList.add('translate-x-full');
    root.classList.remove('opacity-100');
    root.classList.add('opacity-0', 'pointer-events-none', 'invisible');
    root.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.getElementById('cart-toggle-btn')?.addEventListener('click', openCart);
  document.getElementById('cart-toggle-btn-mobile')?.addEventListener('click', openCart);
  backdrop?.addEventListener('click', closeCart);
  closeBtn?.addEventListener('click', closeCart);
  exploreBtn?.addEventListener('click', closeCart);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root?.getAttribute('aria-hidden') === 'false') {
      closeCart();
    }
  });

  window.addEventListener('add-to-cart', (e) => {
    const item = e.detail;
    const cart = getCart();
    const existingIndex = cart.findIndex(c => c.id === item.id);

    if (existingIndex > -1) {
      cart[existingIndex].quantity += (item.quantity || 1);
    } else {
      cart.push({
        id: item.id,
        name: item.name,
        price: item.price,
        unit: item.unit || 'pcs',
        image: item.image || '',
        quantity: item.quantity || 1
      });
    }

    saveCart(cart);
    openCart();
  });

  document.getElementById('cart-checkout-btn')?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) return;

    const notes = document.getElementById('cart-notes')?.value || '';
    let message = `Halo Rasanesia, saya ingin memesan produk dari keranjang website:\n\n`;
    let total = 0;

    cart.forEach((item, idx) => {
      const sub = item.price * item.quantity;
      total += sub;
      message += `${idx + 1}. ${item.name}\n`;
      message += `   Jumlah: ${item.quantity} x Rp ${item.price.toLocaleString('id-ID')} = Rp ${sub.toLocaleString('id-ID')}\n`;
    });

    message += `\n*Total Estimasi: Rp ${total.toLocaleString('id-ID')}*\n`;
    if (notes.trim()) {
      message += `Catatan / Tanggal Acara: ${notes.trim()}\n`;
    }
    message += `\nMohon konfirmasi ketersediaan, total ongkir, dan nomor rekening pembayarannya. Terima kasih!`;

    let activePhone = whatsappNumber;
    try {
      const storedConfig = localStorage.getItem('rasanesia_store_config');
      if (storedConfig) {
        const parsed = JSON.parse(storedConfig);
        if (parsed.whatsappNumber) activePhone = parsed.whatsappNumber;
      }
    } catch (e) {}

    const cleanPhone = String(activePhone).replace(/[^0-9]/g, '');
    const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');
  });

  document.addEventListener('DOMContentLoaded', () => {
    updateBadge();
  });
</script>
