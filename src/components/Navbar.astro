---
import { siteConfig } from '../data/siteConfig';
import { createGeneralInquiryUrl } from '../utils/whatsapp';

const waUrl = createGeneralInquiryUrl();
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full bg-brand-white/95 backdrop-blur-md border-b border-brand-cream-dark transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-brown rounded-lg p-1" aria-label="Rasanesia - Beranda">
        <img 
          src="/images/logo.jpg" 
          alt="Logo Rasanesia" 
          class="w-12 h-12 rounded-full object-cover border border-brand-gold/40 shadow-sm group-hover:scale-105 transition-transform duration-200"
          width="48"
          height="48"
        />
        <div class="flex flex-col">
          <span class="font-serif text-2xl font-bold tracking-tight text-brand-dark group-hover:text-brand-brown transition-colors">
            {siteConfig.brandName}
          </span>
          <span class="text-[10px] uppercase tracking-widest text-brand-muted font-medium">
            {siteConfig.tagline}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Section 3.1: 6 links + CTA) -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Navigasi Utama Desktop">
        {siteConfig.mainNavLinks.map(link => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <a 
              href={link.href}
              class={`text-sm font-medium transition-colors py-1 relative ${
                isActive 
                  ? 'text-brand-brown font-semibold' 
                  : 'text-brand-dark/80 hover:text-brand-brown'
              }`}
            >
              {link.label}
              {isActive && (
                <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-brand-gold rounded-full" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Actions (Cart + Tombol Utama WhatsApp) -->
      <div class="hidden lg:flex items-center gap-4">
        <!-- Cart Trigger Button -->
        <button 
          id="cart-toggle-btn"
          type="button" 
          class="relative p-2.5 rounded-full text-brand-dark hover:bg-brand-cream transition-colors focus:ring-2 focus:ring-brand-brown"
          aria-label="Buka Keranjang Belanja"
        >
          <svg class="w-6 h-6 text-brand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span 
            id="cart-badge" 
            class="hidden absolute -top-1 -right-1 bg-brand-gold text-brand-white text-xs font-bold w-5 h-5 rounded-full items-center justify-center shadow-sm"
          >
            0
          </span>
        </button>

        <!-- Tombol Utama: Pesan via WhatsApp (Addendum Section 3.1 item 7) -->
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green-dark text-brand-white text-sm font-semibold px-5 py-2.5 rounded-full shadow-soft hover:shadow-hover transition-all duration-200 transform hover:-translate-y-0.5"
          aria-label="Pesan via WhatsApp Business"
        >
          <span>Pesan via WhatsApp</span>
          <svg class="w-4 h-4 text-brand-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.06-1.57-.327-.992-.41-1.63-1.424-1.679-1.489-.048-.066-.405-.538-.405-1.026 0-.487.256-.728.347-.827.091-.099.198-.124.264-.124.066 0 .132.001.19.005.061.004.143-.023.223.17.083.199.282.686.307.736.025.05.041.108.008.174-.033.066-.05.107-.099.165-.05.057-.105.128-.15.172-.05.049-.102.102-.044.202.058.099.258.426.554.69.381.339.702.445.801.494.099.05.157.042.215-.025.058-.066.248-.289.314-.388.066-.099.132-.083.223-.05.091.033.578.273.677.322.099.05.165.075.19.116.025.041.025.24-.119.645z" />
          </svg>
        </a>
      </div>

      <!-- Mobile Controls (Cart Button + Hamburger Toggle) -->
      <div class="flex items-center gap-2 lg:hidden">
        <button 
          id="cart-toggle-btn-mobile"
          type="button" 
          class="relative p-2.5 rounded-full text-brand-dark hover:bg-brand-cream transition-colors"
          aria-label="Buka Keranjang Belanja"
        >
          <svg class="w-6 h-6 text-brand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span 
            id="cart-badge-mobile" 
            class="hidden absolute -top-1 -right-1 bg-brand-gold text-brand-white text-xs font-bold w-5 h-5 rounded-full items-center justify-center shadow-sm"
          >
            0
          </span>
        </button>

        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2.5 rounded-lg text-brand-dark hover:bg-brand-cream focus:outline-none focus:ring-2 focus:ring-brand-brown"
          aria-label="Buka Menu Navigasi"
          aria-expanded="false"
        >
          <svg id="menu-icon-bars" class="w-7 h-7 text-brand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-7 h-7 text-brand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-cream-dark bg-brand-white/98 px-4 pt-3 pb-6 shadow-card transition-all">
    <div class="flex flex-col gap-1">
      <span class="text-[10px] font-bold uppercase tracking-wider text-brand-gold px-3 pt-2">Menu Utama</span>
      {siteConfig.mainNavLinks.map(link => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a 
            href={link.href}
            class={`px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              isActive 
                ? 'bg-brand-cream text-brand-brown font-semibold' 
                : 'text-brand-dark hover:bg-brand-cream-light hover:text-brand-brown'
            }`}
          >
            {link.label}
          </a>
        );
      })}

      <span class="text-[10px] font-bold uppercase tracking-wider text-brand-muted px-3 pt-3 border-t border-brand-cream-dark/60 mt-2">Informasi Lain</span>
      <div class="grid grid-cols-2 gap-1">
        {siteConfig.secondaryNavLinks.map(link => (
          <a 
            href={link.href}
            class="px-3 py-2 text-xs text-brand-muted hover:text-brand-brown transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="pt-4 border-t border-brand-cream-dark flex flex-col gap-3 mt-2">
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 bg-brand-green hover:bg-brand-green-dark text-brand-white font-medium py-3 rounded-full text-center shadow-soft"
        >
          <span>Pesan via WhatsApp</span>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.06-1.57-.327-.992-.41-1.63-1.424-1.679-1.489-.048-.066-.405-.538-.405-1.026 0-.487.256-.728.347-.827.091-.099.198-.124.264-.124.066 0 .132.001.19.005.061.004.143-.023.223.17.083.199.282.686.307.736.025.05.041.108.008.174-.033.066-.05.107-.099.165-.05.057-.105.128-.15.172-.05.049-.102.102-.044.202.058.099.258.426.554.69.381.339.702.445.801.494.099.05.157.042.215-.025.058-.066.248-.289.314-.388.066-.099.132-.083.223-.05.091.033.578.273.677.322.099.05.165.075.19.116.025.041.025.24-.119.645z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    iconBars?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
