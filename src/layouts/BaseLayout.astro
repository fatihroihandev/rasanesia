---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { siteConfig } from '../data/siteConfig';
import { createGeneralInquiryUrl } from '../utils/whatsapp';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  preloadHeroImage?: string;
}

const {
  title = `${siteConfig.brandName} - ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = '/images/hero/hero-banner.jpg',
  canonicalUrl = Astro.url.href,
  preloadHeroImage
} = Astro.props;

const absoluteOgImage = image.startsWith('http') ? image : new URL(image, Astro.url.origin).href;
const waUrl = createGeneralInquiryUrl();

const schemaJson = {
  "@context": "https://schema.org",
  "@type": ["Bakery", "FoodEstablishment"],
  "name": siteConfig.brandName,
  "alternateName": "Rasanesia Solo",
  "description": siteConfig.description,
  "image": absoluteOgImage,
  "telephone": siteConfig.whatsappDisplay,
  "areaServed": siteConfig.serviceAreas.map(area => ({
    "@type": "AdministrativeArea",
    "name": area
  })),
  "servesCuisine": "Indonesian Traditional Food & Snack Box",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.locationAddress || "Surakarta & Sukoharjo",
    "addressLocality": "Surakarta",
    "addressRegion": "Jawa Tengah",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -7.56847,
    "longitude": 110.77668
  },
  "url": "https://rasanesia.com",
  "hasMap": siteConfig.locationMapDirectUrl || "https://maps.google.com/?q=Surakarta",
  "priceRange": "Rp 3.500 - Rp 75.000",
  "openingHours": "Mo-Su 07:00-18:00"
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#22140D" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="snack box solo, snack box surakarta, snack box sukoharjo, jajanan pasar solo, katering solo, kue basah solo, snack box murah solo, custom snack box solo, rasanesia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo Local SEO Meta Tags -->
    <meta name="geo.region" content="ID-JT" />
    <meta name="geo.placename" content="Surakarta" />
    <meta name="geo.position" content="-7.56847;110.77668" />
    <meta name="ICBM" content="-7.56847, 110.77668" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteOgImage} />

    {preloadHeroImage && (
      <link rel="preload" as="image" href={preloadHeroImage} fetchpriority="high" />
    )}

    <!-- Non-blocking Google Fonts with Zero-CLS Fallback Metrics -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap"
    />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap" 
      rel="stylesheet" 
      media="print" 
      onload="this.media='all'" 
    />
    <noscript>
      <link 
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap" 
        rel="stylesheet" 
      />
    </noscript>

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
  </head>
  <body class="bg-brand-white text-brand-dark flex flex-col min-h-screen selection:bg-brand-gold selection:text-brand-dark antialiased">
    <!-- Skip to Content Accessibility Link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 bg-brand-brown text-brand-white px-5 py-3 min-h-[44px] inline-flex items-center rounded-full font-semibold shadow-hover"
    >
      Lewati ke konten utama
    </a>

    <!-- Main Navigation -->
    <Navbar />

    <!-- Page Main Content Slot -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Client-side Cart Slideover Drawer -->
    <CartDrawer />

    <!-- Mobile Sticky Floating WhatsApp Quick Button -->
    <aside 
      class="sm:hidden fixed bottom-5 right-5 z-30 safe-bottom" 
      aria-label="Kontak Cepat WhatsApp"
    >
      <a 
        id="floating-wa-btn"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center w-14 h-14 bg-brand-green text-brand-white rounded-full shadow-hover border-2 border-brand-white active:scale-95 transition-transform"
        aria-label="Pesan via WhatsApp"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </a>
    </aside>

    <!-- UMKM In-Website Client Sync + Choreographed Scroll Reveal Script -->
    <script>
      try {
        const storedConfig = localStorage.getItem('rasanesia_store_config');
        if (storedConfig) {
          const cfg = JSON.parse(storedConfig);
          if (cfg.whatsappNumber) {
            const clean = String(cfg.whatsappNumber).replace(/[^0-9]/g, '');
            document.querySelectorAll('a[href*="wa.me"]').forEach(link => {
              const currentHref = link.getAttribute('href') || '';
              const url = new URL(currentHref);
              const text = url.searchParams.get('text') || '';
              link.setAttribute('href', `https://wa.me/${clean}?text=${encodeURIComponent(text)}`);
            });
          }
          if (cfg.operationalHours) {
            const hoursEl = document.getElementById('footer-operational-hours');
            if (hoursEl) hoursEl.textContent = cfg.operationalHours;
          }
        }
      } catch (e) {
        // Safe silent fallback
      }

      // Awwwards Reference 05: Choreographed Scroll Reveal with Reduced-Motion Respect
      (function initScrollReveal() {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealEls = document.querySelectorAll('[data-reveal]');
        if (!revealEls.length || prefersReduced || !('IntersectionObserver' in window)) {
          revealEls.forEach(el => el.classList.add('is-revealed'));
          return;
        }

        document.documentElement.classList.add('js-reveal-ready');
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              target.style.willChange = 'transform, opacity';
              target.classList.add('is-revealed');
              setTimeout(() => {
                target.style.willChange = 'auto';
              }, 950);
              obs.unobserve(target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        revealEls.forEach(el => observer.observe(el));
      })();
    </script>
  </body>
</html>
